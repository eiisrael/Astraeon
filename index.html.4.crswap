      {
        "name": "Cajado Astral",
        "type": "staff",
        "attack": 7,
        "crit": 6,
        "speed": 100
      },
      {
        "name": "Adaga Sombria",
        "type": "dagger",
        "attack": 11,
        "crit": 12,
        "speed": 135
      }
    ]
  },
  "ai": {
    "patrolFactor": 0.12,
    "attackMinCooldown": 0.55,
    "aggroBase": 110,
    "nightBonus": 1.25
  },
  "visualLogic": [
    {
      "event": "region_discovered",
      "condition": "always",
      "action": "mark_map"
    },
    {
      "event": "enemy_defeated",
      "condition": "boss",
      "action": "xp"
    },
    {
      "event": "night_start",
      "condition": "always",
      "action": "toast"
    }
  ],
  "page": {
    "elements": {
      "newBtn": {
        "label": "NOVO JOGO",
        "text": "NOVO JOGO",
        "visible": true,
        "disabled": false
      },
      "continueBtn": {
        "label": "CONTINUAR",
        "text": "CONTINUAR",
        "visible": true,
        "disabled": false
      },
      "settingsBtn": {
        "label": "CONFIGURAÇÕES",
        "text": "CONFIGURAÇÕES",
        "visible": true,
        "disabled": false
      },
      "questTracker": {
        "label": "Painel de missão",
        "visible": true
      },
      "qtitle": {
        "label": "Título da missão",
        "text": "Fale com o ancião da vila.",
        "visible": true
      },
      "qdesc": {
        "label": "Descrição da missão",
        "text": "Encontre o NPC marcado.",
        "visible": true
      },
      "seedInput": {
        "label": "Seed do mundo",
        "placeholder": "Seed do mundo (opcional)",
        "visible": true,
        "disabled": false
      }
    },
    "custom": {
      "selector": "",
      "text": "",
      "placeholder": "",
      "visible": true,
      "disabled": false
    },
    "theme": {
      "titleColor": "",
      "textColor": "",
      "globalFontSize": 16,
      "pageTitle": "ASTRAEON — MMORPG Procedural",
      "gameTitle": "ASTRAEON",
      "buttonRadius": 8,
      "buttonScale": 1,
      "globalFont": ""
    }
  }
};
/* GENESIS_CONFIG_END */
let GENESIS_CONFIG = JSON.parse(JSON.stringify(GENESIS_DEFAULT_CONFIG));

function genesisDeepMerge(target, source){
  if(!source || typeof source!=="object") return target;
  for(const [k,v] of Object.entries(source)){
    if(v && typeof v==="object" && !Array.isArray(v)){
      if(!target[k] || typeof target[k]!=="object") target[k]={};
      genesisDeepMerge(target[k],v);
    }else target[k]=v;
  }
  return target;
}
function genesisApplyPageConfig(page){
  if(!page) return;
  const theme=page.theme||{};
  if(theme.pageTitle) document.title=String(theme.pageTitle);
  const gameTitle=document.querySelector(".title");
  if(gameTitle && Object.prototype.hasOwnProperty.call(theme,"gameTitle")) gameTitle.textContent=String(theme.gameTitle);

  const elements=page.elements||{};
  const apply=(id,d)=>{
    const el=document.getElementById(id);
    if(!el||!d) return;
    if(Object.prototype.hasOwnProperty.call(d,"text")) el.textContent=d.text;
    if(Object.prototype.hasOwnProperty.call(d,"placeholder") && "placeholder" in el) el.placeholder=d.placeholder;
    if(Object.prototype.hasOwnProperty.call(d,"visible")) el.style.display=d.visible?"":"none";
    if(Object.prototype.hasOwnProperty.call(d,"disabled")) el.disabled=!!d.disabled;
  };
  Object.entries(elements).forEach(([id,d])=>apply(id,d));

  const custom=page.custom||{};
  if(custom.selector){
    try{
      document.querySelectorAll(custom.selector).forEach(el=>{
        if(custom.text) el.textContent=custom.text;
        if("placeholder" in el && custom.placeholder) el.placeholder=custom.placeholder;
        el.style.display=custom.visible===false?"":"";
        if("disabled" in el) el.disabled=!!custom.disabled;
      });
    }catch(e){ console.warn("[ASTRAEON PAGE EDITOR]",e); }
  }

  let style=document.getElementById("genesis-page-theme");
  if(!style){ style=document.createElement("style"); style.id="genesis-page-theme"; document.head.appendChild(style); }
  const rules=[];
  if(theme.titleColor) rules.push(".title,#mainMenuContent .title{color:"+theme.titleColor+" !important}");
  if(theme.textColor) rules.push("body,body *{color:"+theme.textColor+" !important}");
  if(Number.isFinite(Number(theme.globalFontSize))) rules.push("body{font-size:"+Number(theme.globalFontSize)+"px !important} body button,body input,body textarea,body select{font-size:"+Number(theme.globalFontSize)+"px !important}");
  if(theme.globalFont) rules.push("body{font-family:"+String(theme.globalFont).replace(/[{};]/g,"")+" !important}");
  if(Number.isFinite(Number(theme.buttonRadius))) rules.push(".btn{border-radius:"+Number(theme.buttonRadius)+"px !important}");
  if(Number.isFinite(Number(theme.buttonScale))) rules.push(".btn{transform:scale("+Number(theme.buttonScale)+");transform-origin:center}");
  style.textContent=rules.join("\n");
}

function genesisApplyConfig(raw){
  GENESIS_CONFIG=genesisDeepMerge(JSON.parse(JSON.stringify(GENESIS_DEFAULT_CONFIG)),raw||{});
  const g=GENESIS_CONFIG;
  genesisApplyPageConfig(g.page);
  if(g.world?.colors) Object.assign(COLORS,g.world.colors);
  if(g.visuals?.player) Object.assign(g.visuals.player,{});
  for(const [name,d] of Object.entries(g.visuals?.monsters||{})){
    const e=ENEMY_TYPES.find(x=>x[0]===name);
    if(e && d){
      e[7]=d.color;e[8]=d.scale;e[9]=d.shape;
    }
  }
  for(const [name,d] of Object.entries(g.classes||{})){
    if(CLASS_DATA[name]) Object.assign(CLASS_DATA[name],d);
    else CLASS_DATA[name]={hp:+d.hp||100,mp:+d.mp||50,attack:+d.attack||12,defense:+d.defense||8,magic:+d.magic||8,speed:+d.speed||140,crit:+d.crit||5,luck:+d.luck||5,color:d.color||"#c7d0df",skill:d.skill||"Nova habilidade"};
  }
  for(const [name,d] of Object.entries(g.visuals?.monsters||{})){
    if(name!=="Slime" && !ENEMY_TYPES.some(x=>x[0]===name)){
      const st=g.monsterStats?.[name]||{};
      ENEMY_TYPES.push([name,+st.hp||60,+st.attack||12,+st.defense||5,+st.speed||60,+st.xp||40,st.biome||"plain",d.color||"#8f9bb5",+d.scale||1,d.shape||"orb"]);
    }
  }
  for(const [name,d] of Object.entries(g.monsterStats||{})){
    const e=ENEMY_TYPES.find(x=>x[0]===name);
    if(e && d){
      if(Number.isFinite(+d.hp))e[1]=+d.hp;
      if(Number.isFinite(+d.attack))e[2]=+d.attack;
      if(Number.isFinite(+d.defense))e[3]=+d.defense;
      if(Number.isFinite(+d.speed))e[4]=+d.speed;
      if(Number.isFinite(+d.xp))e[5]=+d.xp;
      if(d.biome)e[6]=d.biome;
    }
  }
  for(const m of (g.extraMonsters||[])){
    if(!m?.name || ENEMY_TYPES.some(x=>x[0]===m.name)) continue;
    ENEMY_TYPES.push([m.name,+m.hp||30,+m.attack||8,+m.defense||4,+m.speed||55,+m.xp||25,m.biome||"plain",m.color||"#9b6d7a",+m.scale||1,m.shape||"orb"]);
  }
  if(Array.isArray(g.items?.weapons) && g.items.weapons.length){
    WEAPONS.splice(0,WEAPONS.length,...g.items.weapons.map(w=>[w.name,w.type||"sword",+w.attack||0,+w.crit||0,+w.speed||100]));
  }
  if(g.game?.maxLevel) { /* future-proof runtime setting */ }
  if(window.GENESIS_GAME) window.GENESIS_GAME.config=g;
}
function genesisLoadConfig(){
  try{
    const raw=localStorage.getItem("GENESIS_EDITOR_CONFIG");
    if(raw) genesisApplyConfig(JSON.parse(raw));
  }catch(e){console.warn("[GENESIS] config inválida",e)}
}
function genesisPersistConfig(){
  try{localStorage.setItem("GENESIS_EDITOR_CONFIG",JSON.stringify(GENESIS_CONFIG));}catch(e){}
}
function genesisSetConfig(raw){
  genesisApplyConfig(raw);
  genesisPersistConfig();
  if(typeof save==="function" && player) save();
}
window.__GENESIS_APPLY_CONFIG = genesisSetConfig;
window.__GENESIS_GET_CONFIG = ()=>JSON.parse(JSON.stringify(GENESIS_CONFIG));
genesisLoadConfig();

/* Visual helpers */
function genesisRunLogic(event,ctx={}){
  for(const rule of (GENESIS_CONFIG.visualLogic||[])){
    if(rule.event!==event)continue;
    let ok=rule.condition==="always";
    if(rule.condition==="boss")ok=!!ctx.enemy&&["Golem","Draconato","Troll"].includes(ctx.enemy.kind);
    if(rule.condition==="low_hp")ok=!!player&&player.hp/player.stats().hp<.3;
    if(rule.condition==="night")ok=isNight();
    if(!ok)continue;
    switch(rule.action){
      case "toast": toast(ctx.message||"Evento do mundo"); break;
      case "xp": if(player)player.gainXP(ctx.amount||50); break;
      case "gold": if(player)player.gold+=Math.floor(ctx.amount||25); break;
      case "heal": if(player){const s=player.stats();player.hp=clamp(player.hp+(ctx.amount||25),0,s.hp);burst(player.x,player.y,"#6de39b",12)} break;
      case "mark_map": break;
      case "burst": if(ctx.enemy)burst(ctx.enemy.x,ctx.enemy.y,"#f3d56f",24); break;
    }
  }
}
const GENESIS_IMAGE_CACHE = new Map();
function genesisGetImage(src){
  if(!src) return null;
  let im=GENESIS_IMAGE_CACHE.get(src);
  if(im) return im;
  im=new Image();
  im.src=src;
  GENESIS_IMAGE_CACHE.set(src,im);
  return im;
}
function genesisDrawAssetImage(im,x,y,size,glowColor,glowSize){
  if(!im || !im.complete || !im.naturalWidth) return false;
  ctx.save();
  if(glowColor){ctx.shadowBlur=glowSize||18;ctx.shadowColor=glowColor;}
  ctx.drawImage(im,x-size/2,y-size/2,size,size);
  ctx.restore();
  return true;
}
function genesisVisualMonster(e){
  const d=GENESIS_CONFIG.visuals.monsters[e.kind]||{};
  return {shape:d.shape||"orb",color:e.flash>0?"#fff":d.color||"#9b6d7a",scale:Number(d.scale)||1,outline:d.outline||"#fff",glow:!!d.glow,image:d.image||"",glowSize:Number(d.glowSize)||18};
}
function genesisMonsterShape(shape,r){
  ctx.beginPath();
  if(shape==="slime"){ctx.moveTo(-r,r*.45);ctx.quadraticCurveTo(-r*.9,-r*.7,0,-r*.8);ctx.quadraticCurveTo(r*.9,-r*.7,r,r*.45);ctx.quadraticCurveTo(0,r*.95,-r,r*.45)}
  else if(shape==="wolf"){ctx.moveTo(-r,-r*.1);ctx.lineTo(-r*.75,-r*.75);ctx.lineTo(-r*.2,-r*.55);ctx.lineTo(r*.25,-r*.6);ctx.lineTo(r*.9,-r*.85);ctx.lineTo(r*.75,-r*.1);ctx.quadraticCurveTo(r*.5,r*.8,0,r*.9);ctx.quadraticCurveTo(-r*.6,r*.75,-r,-r*.1)}
  else if(shape==="spider"){ctx.arc(0,0,r*.55,0,Math.PI*2);for(let a=0;a<Math.PI*2;a+=Math.PI/4){ctx.moveTo(Math.cos(a)*r*.35,Math.sin(a)*r*.35);ctx.lineTo(Math.cos(a)*r*1.25,Math.sin(a)*r*1.25)}}
  else if(shape==="golem"){ctx.moveTo(-r*.75,r*.8);ctx.lineTo(-r*.9,-r*.35);ctx.lineTo(-r*.4,-r*.9);ctx.lineTo(r*.45,-r*.8);ctx.lineTo(r*.9,-r*.2);ctx.lineTo(r*.65,r*.8);ctx.closePath()}
  else if(shape==="dragon"){ctx.moveTo(-r*.9,.4*r);ctx.lineTo(-r*.55,-.55*r);ctx.lineTo(-.15*r,-.95*r);ctx.lineTo(.2*r,-.55*r);ctx.lineTo(.9*r,-.8*r);ctx.lineTo(.62*r,.1*r);ctx.lineTo(.95*r,.65*r);ctx.lineTo(.15*r,.55*r);ctx.lineTo(-.25*r,.95*r);ctx.closePath()}
  else if(shape==="skeleton"){ctx.arc(0,-r*.35,r*.48,0,Math.PI*2);ctx.moveTo(-r*.5,r*.05);ctx.lineTo(r*.5,r*.05);ctx.lineTo(r*.35,r*.75);ctx.lineTo(-r*.35,r*.75);ctx.closePath()}
  else {ctx.arc(0,0,r,0,Math.PI*2)}
}
function genesisDrawEntityFace(r,kind){
  ctx.fillStyle="#101421";ctx.beginPath();ctx.arc(-r*.28,-r*.15,r*.11,0,Math.PI*2);ctx.arc(r*.28,-r*.15,r*.11,0,Math.PI*2);ctx.fill();
  if(kind==="Slime"){ctx.fillStyle="rgba(255,255,255,.75)";ctx.beginPath();ctx.arc(-r*.22,-r*.21,r*.06,0,7);ctx.arc(r*.34,-r*.21,r*.06,0,7);ctx.fill()}
}
function genesisDrawPlayer(p){
  const d=GENESIS_CONFIG.visuals.player||{},r=17*(Number(d.scale)||1);
  ctx.save();ctx.translate(p.x,p.y);
  const ang=Math.atan2(mouse.y-p.y,mouse.x-p.x);ctx.rotate(ang);
  if(d.glow){ctx.shadowBlur=18;ctx.shadowColor=CLASS_DATA[player.class].color}
  ctx.fillStyle=player.block?"#e6c46a":CLASS_DATA[player.class].color;
  ctx.strokeStyle=d.outline||"#fff";ctx.lineWidth=2;
  if(d.shape==="orb"){
    ctx.beginPath();ctx.arc(0,0,r,0,Math.PI*2);ctx.fill();ctx.stroke();
    ctx.fillStyle="rgba(255,255,255,.28)";ctx.beginPath();ctx.arc(-r*.35,-r*.35,r*.35,0,Math.PI*2);ctx.fill();
  }else{
    // HERO: corpo, cabeça, capa, pernas e arma — visual distinto do ORB.
    const bodyW=r*1.05, bodyH=r*1.45;
    ctx.fillStyle="rgba(10,15,28,.9)";
    ctx.beginPath();ctx.moveTo(-bodyW*.8,r*.95);ctx.lineTo(-bodyW*.52,-r*.1);ctx.quadraticCurveTo(-bodyW*.5,-r*.85,0,-r*.9);ctx.quadraticCurveTo(bodyW*.5,-r*.85,bodyW*.52,-r*.1);ctx.lineTo(bodyW*.8,r*.95);ctx.closePath();ctx.fill();ctx.stroke();
    ctx.fillStyle=CLASS_DATA[player.class].color;
    ctx.beginPath();ctx.roundRect(-bodyW*.62,-bodyH*.15,bodyW*1.24,bodyH*.95, r*.22);ctx.fill();ctx.stroke();
    ctx.fillStyle="#f0c9a4";ctx.beginPath();ctx.arc(0,-r*.65,r*.46,0,Math.PI*2);ctx.fill();ctx.stroke();
    ctx.fillStyle="#111827";ctx.beginPath();ctx.arc(0,-r*.78,r*.48,Math.PI,Math.PI*2);ctx.fill();
    ctx.fillStyle="#111827";ctx.fillRect(-r*.48,r*.78,r*.34,r*.62);ctx.fillRect(r*.14,r*.78,r*.34,r*.62);
    ctx.fillStyle=d.weaponGlow||"#dce9ff";ctx.fillRect(r*.25,-2,r*1.25,4);
  }
  const classImg=CLASS_DATA[player.class]?.image?genesisGetImage(CLASS_DATA[player.class].image):null;
  if(classImg && classImg.complete && classImg.naturalWidth){ctx.save();ctx.rotate(-ang);genesisDrawAssetImage(classImg,0,0,r*2.35,d.glow?CLASS_DATA[player.class].color:null,18);ctx.restore();}
  ctx.restore();
}

</script>


<script>
/* =========================================================
   GENESIS RUNTIME BRIDGE
   Comunicação entre index.html e game-editor.html
========================================================= */

window.GENESIS_GAME = window.GENESIS_GAME || {
    version: "2.0.0",
    data: {},
    initialized: false
};


/* ---------------------------------------------------------
   Aplicar configuração recebida
--------------------------------------------------------- */

window.applyGenesisEditorData = function(data){

    if(!data || typeof data !== "object")
        return;

    window.GENESIS_GAME.data = data;

    /*
       Eventos que o próprio jogo pode escutar.
    */

    window.dispatchEvent(
        new CustomEvent("genesis:data-changed", {
            detail: data
        })
    );

    console.log(
        "[GENESIS] Dados atualizados pelo Editor",
        data
    );
};


/* ---------------------------------------------------------
   BroadcastChannel
   Permite comunicação em tempo real com o editor.
--------------------------------------------------------- */

try {

    const genesisChannel =
        new BroadcastChannel("GENESIS_GAME_EDITOR");

    genesisChannel.onmessage = function(event){

        if(!event.data)
            return;

        if(event.data.type === "GENESIS_UPDATE"){
            window.applyGenesisEditorData(event.data.data);
            if(typeof window.__GENESIS_APPLY_CONFIG === "function"){
                try{ window.__GENESIS_APPLY_CONFIG(event.data.data); }catch(e){ console.warn("[GENESIS] live apply",e); }
            }
        }

    };

    window.GENESIS_GAME.channel =
        genesisChannel;

}
catch(error){

    console.warn(
        "[GENESIS] BroadcastChannel indisponível.",
        error
    );

}


/* ---------------------------------------------------------
   localStorage fallback
--------------------------------------------------------- */

window.addEventListener(
    "storage",
    function(event){

        if(event.key !== "GENESIS_RUNTIME_DATA")
            return;

        try{

            const data =
                JSON.parse(event.newValue);

            window.applyGenesisEditorData(data);

        }
        catch(error){

            console.warn(
                "[GENESIS] Dados inválidos.",
                error
            );

        }

    }
);


/* ---------------------------------------------------------
   Receber dados já existentes
--------------------------------------------------------- */

try{

    const saved =
        localStorage.getItem(
            "GENESIS_RUNTIME_DATA"
        );

    if(saved){

        window.applyGenesisEditorData(
            JSON.parse(saved)
        );

    }

}
catch(error){

    console.warn(
        "[GENESIS] Não foi possível ler configuração.",
        error
    );

}


window.GENESIS_GAME.initialized = true;
try{window.parent?.postMessage({type:"GENESIS_READY"},"*")}catch(e){}


/* ---------------------------------------------------------
   API simples para o próprio jogo
--------------------------------------------------------- */

window.GenesisGame = {

    get(path, fallback = null){

        const parts =
            String(path)
                .split(".")
                .filter(Boolean);

        let value =
            window.GENESIS_GAME.data;

        for(const part of parts){

            if(
                value === null ||
                value === undefined
            )
                return fallback;

            value = value[part];

        }

        return value === undefined
            ? fallback
            : value;

    },


    set(path,value){

        const parts =
            String(path)
                .split(".")
                .filter(Boolean);

        let target =
            window.GENESIS_GAME.data;

        for(let i=0;i<parts.length-1;i++){

            const part=parts[i];

            if(
                !target[part] ||
                typeof target[part] !== "object"
            ){

                target[part]={};

            }

            target=target[part];

        }

        target[
            parts[parts.length-1]
        ]=value;

        window.applyGenesisEditorData(
            window.GENESIS_GAME.data
        );

    }

};
</script>

</body>
</html>