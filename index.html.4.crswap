<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="color-scheme" content="dark">
<title>ASTRAEON — MMORPG Procedural</title>
<style>
:root{
  --bg:#070a12;--panel:rgba(9,13,24,.82);--panel2:rgba(18,23,39,.9);
  --line:rgba(190,207,255,.16);--text:#edf2ff;--muted:#9aa6c3;
  --gold:#e6c46a;--cyan:#65d9ff;--red:#ff6678;--green:#6de39b;
  --shadow:0 18px 50px rgba(0,0,0,.48);
}
*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:var(--bg);color:var(--text);font-family:Inter,Segoe UI,system-ui,sans-serif}
button,input{font:inherit}button{color:inherit}
#app{position:fixed;inset:0;background:#05070d}
canvas{position:absolute;inset:0;width:100%;height:100%;display:block;image-rendering:auto}
#vignette{position:absolute;inset:0;pointer-events:none;background:radial-gradient(circle at 50% 45%,transparent 35%,rgba(0,0,0,.28) 100%);z-index:3}
.screen{position:absolute;inset:0;z-index:20;display:flex;align-items:center;justify-content:center;background:radial-gradient(circle at 50% 40%,rgba(33,48,90,.28),rgba(3,5,10,.94) 70%);backdrop-filter:blur(4px)}
.hidden{display:none!important}
.title{font-family:Georgia,serif;letter-spacing:.18em;font-size:clamp(30px,5vw,60px);margin:0;text-shadow:0 0 35px rgba(101,217,255,.28);text-align:center}
.subtitle{text-align:center;color:var(--gold);letter-spacing:.38em;margin:10px 0 34px;font-size:12px}
.menu{width:min(520px,92vw);padding:34px;border:1px solid var(--line);border-radius:24px;background:rgba(7,10,18,.78);box-shadow:var(--shadow);position:relative;overflow:hidden}
.menu:before{content:"";position:absolute;inset:-50%;background:conic-gradient(from 0deg,transparent,rgba(101,217,255,.08),transparent 25%);animation:spin 12s linear infinite}
.menu>*{position:relative}
@keyframes spin{to{transform:rotate(360deg)}}
.btn{width:100%;padding:14px 18px;margin:7px 0;border:1px solid var(--line);border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,.08),rgba(255,255,255,.025));cursor:pointer;transition:.18s;letter-spacing:.08em}
.btn:hover{transform:translateY(-2px);border-color:rgba(101,217,255,.45);box-shadow:0 8px 25px rgba(0,0,0,.25)}
.btn.primary{border-color:rgba(230,196,106,.45);background:linear-gradient(180deg,rgba(230,196,106,.2),rgba(230,196,106,.05))}
.seedbox{display:flex;gap:8px;margin:15px 0 8px}.seedbox input{flex:1;background:#060914;border:1px solid var(--line);border-radius:10px;padding:11px;color:var(--text);outline:none}
#hud{position:absolute;inset:0;z-index:5;pointer-events:none}.hud>*{pointer-events:auto}
.topbar{position:absolute;left:18px;top:16px;width:min(420px,calc(100vw - 36px));padding:12px 14px;border:1px solid var(--line);border-radius:16px;background:var(--panel);box-shadow:var(--shadow);backdrop-filter:blur(12px)}
.playerline{display:flex;align-items:center;justify-content:space-between;font-size:13px}.playerline strong{font-size:16px}.badge{padding:3px 8px;border-radius:999px;background:rgba(101,217,255,.12);color:var(--cyan);font-size:11px}
.bar{height:8px;background:#02040a;border-radius:8px;overflow:hidden;margin-top:7px;border:1px solid rgba(255,255,255,.08)}.fill{height:100%;width:100%;transition:width .2s}.hp{background:linear-gradient(90deg,#9d3045,#ff6c79)}.mp{background:linear-gradient(90deg,#285aa9,#6ccfff)}.xp{background:linear-gradient(90deg,#8c6a2b,#f3d56f)}
.statrow{display:flex;gap:8px;color:var(--muted);font-size:10px;margin-top:8px}.statrow span{flex:1}.statrow b{display:block;color:var(--text);font-size:11px}
.quest{position:absolute;right:18px;top:16px;width:270px;max-width:calc(100vw - 36px);padding:14px;border:1px solid var(--line);border-radius:16px;background:var(--panel);box-shadow:var(--shadow);backdrop-filter:blur(12px)}
.quest h3{margin:0 0 8px;color:var(--gold);font:600 14px Georgia,serif}.quest p{margin:4px 0;color:#cbd4e8;font-size:12px}.qprog{height:5px;background:#05070d;border-radius:5px;margin-top:8px;overflow:hidden}.qprog i{display:block;height:100%;background:var(--gold)}
.minimap{position:absolute;right:18px;bottom:18px;width:180px;height:180px;border-radius:50%;border:2px solid rgba(230,196,106,.35);overflow:hidden;background:rgba(5,8,14,.82);box-shadow:var(--shadow)}#mapCanvas{width:100%;height:100%}
.hotbar{position:absolute;left:50%;bottom:20px;transform:translateX(-50%);display:flex;gap:5px;padding:7px;border-radius:14px;border:1px solid var(--line);background:var(--panel);backdrop-filter:blur(10px)}
.slot{width:52px;height:52px;border:1px solid var(--line);border-radius:99px;background:rgba(255,255,255,.045);position:relative;display:grid;place-items:center;cursor:pointer;font-size:20px}.slot:hover{border-color:var(--cyan)}.slot kbd{position:absolute;left:5px;top:3px;color:var(--muted);font-size:9px}.slot small{position:absolute;right:4px;bottom:2px;color:var(--gold);font-size:8px}
.toast{position:absolute;left:50%;top:18%;transform:translateX(-50%);padding:10px 16px;border-radius:999px;background:rgba(6,9,16,.82);border:1px solid var(--line);color:#fff;opacity:0;transition:.25s;box-shadow:var(--shadow);z-index:40;pointer-events:none}.toast.show{opacity:1}
.menuPanel{position:absolute;inset:7% 7%;z-index:25;background:rgba(6,9,16,.96);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow);backdrop-filter:blur(18px);overflow:auto;padding:24px}
.close{position:absolute;right:18px;top:14px;border:0;background:none;font-size:24px;cursor:pointer;color:var(--muted)}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:10px;margin-top:18px}.card{padding:13px;border:1px solid var(--line);border-radius:13px;background:rgba(255,255,255,.035)}.card h4{margin:0 0 6px}.card p{margin:3px 0;color:var(--muted);font-size:12px}.rar-common{color:#c9d0dd}.rar-uncommon{color:#71e29c}.rar-rare{color:#65b8ff}.rar-epic{color:#c58cff}.rar-legendary{color:#f0c75d}.rar-mythic{color:#ff77b8}
.classGrid{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:10px;margin:15px 0}
.classChoice{padding:14px 10px;border:1px solid var(--line);border-radius:12px;background:rgba(255,255,255,.03);cursor:pointer;text-align:center;transition:.2s}
.classChoice:hover,.classChoice.active{border-color:var(--gold);background:rgba(230,196,106,.15);transform:translateY(-2px)}
.classChoice b{display:block;font-size:14px;color:var(--gold);margin-bottom:4px}
.classChoice small{color:var(--muted);font-size:11px;line-height:1.3;display:block}
#death{z-index:30}.deathbox{text-align:center;padding:38px}.deathbox h2{font:42px Georgia,serif;color:#ff7180;margin:0}.deathbox p{color:var(--muted)}
#hint{position:absolute;left:18px;bottom:20px;color:rgba(237,242,255,.65);font-size:10px;letter-spacing:.03em}
@media(max-width:800px){.quest{display:none}.minimap{width:130px;height:130px}.hotbar .slot{width:42px;height:42px}.hotbar{bottom:8px}.slot:nth-child(n+7){display:none}.menuPanel{inset:3% 3%}}

/* GENESIS visual upgrade */
.stamina{background:linear-gradient(90deg,#2a8f83,#7ff5d4)}
.staminaBar{opacity:.95}



@media(max-width:720px){.minimap{width:130px;height:130px}.hotbar{gap:2px;bottom:8px}.slot{width:42px;height:42px}.quest{top:auto;bottom:72px;right:8px}.topbar{left:8px;top:8px}}
.inventory-shell{display:grid;grid-template-columns:minmax(0,1fr) 290px;gap:18px;margin-top:18px}.inventory-grid{display:grid;grid-template-columns:repeat(6,minmax(58px,1fr));gap:7px;padding:10px;border:1px solid var(--line);border-radius:14px;background:rgba(0,0,0,.18)}.inv-slot{aspect-ratio:1;border:1px solid rgba(190,207,255,.15);border-radius:9px;background:linear-gradient(145deg,rgba(255,255,255,.055),rgba(255,255,255,.015));position:relative;display:grid;place-items:center;cursor:pointer}.inv-slot:hover{border-color:var(--cyan);box-shadow:0 0 15px rgba(101,217,255,.12)}.inv-slot img,.equip-item img{width:32px;height:32px;object-fit:contain}.inv-slot .itype,.inv-slot .level{position:absolute;font-size:8px;color:#9fb0ca}.inv-slot .itype{left:4px;top:3px}.inv-slot .level{left:4px;bottom:3px}.inv-slot.empty:after{content:'+';color:#34415a;font-size:17px}.equipment-panel{border:1px solid var(--line);border-radius:14px;padding:12px;background:rgba(255,255,255,.025)}.equipment-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:8px}.equip-slot{min-height:78px;border:1px dashed rgba(230,196,106,.28);border-radius:10px;padding:7px;text-align:center;background:rgba(230,196,106,.025)}.equip-slot.dragover{border-color:var(--gold);box-shadow:0 0 18px rgba(230,196,106,.16)}.equip-item{margin-top:5px;display:flex;align-items:center;justify-content:center;gap:5px;font-size:10px}.item-detail{margin-top:12px;padding:12px;border:1px solid var(--line);border-radius:12px;background:#080d16}.item-detail-head{display:flex;align-items:center;gap:10px}.item-detail-image{width:32px;height:32px;object-fit:contain}.item-detail .statline{display:grid;grid-template-columns:repeat(3,1fr);gap:4px;font-size:10px;color:var(--muted);margin-top:8px}@media(max-width:850px){.inventory-shell{grid-template-columns:1fr}.inventory-grid{grid-template-columns:repeat(5,minmax(54px,1fr))}}</style>
<style id="genesis-4-2-compact-ui">
.menuPanel.inventory-compact{inset:12% auto auto 50%;transform:translateX(-50%);width:min(720px,calc(100vw - 28px));max-height:min(570px,78vh);padding:16px;border-radius:18px}
.inventory-compact .inventory-shell{grid-template-columns:minmax(0,1fr) 205px;gap:10px;margin-top:10px}.inventory-compact .inventory-grid{grid-template-columns:repeat(6,42px);grid-auto-rows:42px;gap:5px;padding:7px;justify-content:start}.inventory-compact .inv-slot{width:42px;height:42px;border-radius:8px}.inventory-compact .inv-slot img,.inventory-compact .equip-item img{width:30px;height:30px}.inventory-compact .equipment-panel{padding:8px}.inventory-compact .equipment-grid{gap:5px}.inventory-compact .equip-slot{min-height:54px;padding:4px;font-size:9px}.inventory-compact .equip-item span{display:none}.inventory-compact .inv-actions,.inventory-compact #invDetails{display:none}.inventory-compact .item-tooltip{position:fixed;z-index:100;min-width:190px;max-width:250px;padding:9px 10px;border:1px solid rgba(130,170,220,.28);border-radius:10px;background:rgba(7,12,22,.78);backdrop-filter:blur(12px);box-shadow:0 10px 30px rgba(0,0,0,.4);pointer-events:none;color:#eaf1ff;font-size:10px}.inventory-compact .item-tooltip h4{margin:0 0 4px;font-size:12px}.inventory-compact .item-tooltip p{margin:2px 0;color:#aab8ce}.inventory-compact .item-tooltip .tipstats{display:grid;grid-template-columns:1fr 1fr;gap:2px 8px;margin-top:5px;color:#d7e3f7}.inventory-compact .inv-slot .itype,.inventory-compact .inv-slot .level{display:none}.minimap{display:block!important;z-index:12!important;visibility:visible!important;opacity:1!important}.menuPanel.map-compact{inset:8% auto auto 50%;transform:translateX(-50%);width:min(820px,calc(100vw - 28px));max-height:82vh;padding:16px}.map-compact #bigMap{width:100%!important;height:auto!important;max-height:58vh;object-fit:contain}.class-preview-image{width:44px;height:44px;object-fit:contain;border-radius:9px;border:1px solid var(--line);vertical-align:middle;margin-right:7px}
</style></head>
<body>
<div id="app">
<canvas id="world"></canvas><div id="vignette"></div>

<div id="start" class="screen">
  <div class="menu" id="mainMenuContent">
    <h1 class="title">ASTRAEON</h1><div class="subtitle">PROCEDURAL MMORPG</div>
    <div id="mainButtons">
      <button class="btn primary" id="newBtn">NOVO JOGO</button>
      <button class="btn" id="continueBtn">CONTINUAR</button>
      <button class="btn" id="settingsBtn">CONFIGURAÇÕES</button>
      <div class="seedbox"><input id="seedInput" type="number" placeholder="Seed do mundo (opcional)"><button class="btn" style="width:auto;margin:0" id="randomSeed">↻</button></div>
    </div>
    <div id="classSelectView" class="hidden">
      <h3 style="text-align:center;color:var(--gold);margin:0 0 10px">ESCOLHA SUA CLASSE</h3>
      <div class="classGrid" id="classGridMenu"></div>
      <button class="btn" id="backMenuBtn">VOLTAR</button>
    </div>
    <div style="text-align:center;color:#707b96;font-size:10px;margin-top:15px">Offline • Canvas 2D • ASTRAEON Engine</div>
  </div>
</div>

<div id="hud" class="hidden">
  <div class="topbar">
    <div class="playerline"><strong id="pname">Aventureiro</strong><span class="badge" id="pclass">Guerreiro</span><span>Lv <b id="plevel">1</b></span></div>
    <div class="bar"><div id="hpbar" class="fill hp"></div></div>
    <div class="bar"><div id="mpbar" class="fill mp"></div></div>
    <div class="bar"><div id="xpbar" class="fill xp"></div></div>
    <div class="statrow"><span>HP <b id="hptext">100/100</b></span><span>MP <b id="mptext">40/40</b></span><span>ATK <b id="atktext">12</b></span><span>DEF <b id="deftext">8</b></span></div>
  </div>
  <div class="quest" id="questTracker"><h3>MISSÃO</h3><p id="qtitle">Fale com o ancião da vila.</p><p id="qdesc">Encontre o NPC marcado.</p><div class="qprog"><i id="qfill" style="width:0"></i></div><p id="qcount">0/1</p></div>
  <div class="minimap"><canvas id="mapCanvas" width="180" height="180"></canvas></div>
  <div class="hotbar">
    <button class="slot" data-skill="0"><kbd>1</kbd>⚔<small>ataque</small></button>
    <button class="slot" data-skill="1"><kbd>2</kbd>✦<small>habilidade</small></button>
    <button class="slot" data-skill="2"><kbd>3</kbd>🛡<small>bloqueio</small></button>
    <button class="slot" data-skill="3"><kbd>4</kbd>➤<small>esquiva</small></button>
    <button class="slot" data-skill="4"><kbd>5</kbd>✹<small>especial</small></button>
    <button class="slot" data-skill="5"><kbd>6</kbd>✚<small>cura</small></button>
    <button class="slot" data-skill="6"><kbd>7</kbd>⌁<small>dash</small></button>
    <button class="slot" data-skill="7"><kbd>8</kbd>☄<small>ultimate</small></button>
  </div>
  <div id="hint">WASD mover • mouse mirar • clique atacar • I inventário • C personagem • M mapa • Q quests • E interagir • ESC fechar</div>
  <div class="toast" id="toast"></div>
</div>

<div id="panel" class="hidden menuPanel"></div>
<div id="death" class="screen hidden"><div class="deathbox"><h2>VOCÊ CAIU</h2><p>O mundo continua seu ciclo. Seu último ponto seguro aguarda.</p><button class="btn primary" id="respawnBtn">RESPAWN</button></div></div>

<script>
"use strict";

/* ---------- Core utilities ---------- */
const clamp=(v,a,b)=>Math.max(a,Math.min(b,v));
const dist=(a,b)=>Math.hypot(a.x-b.x,a.y-b.y);
const uid=(p="e")=>p+"_"+Math.random().toString(36).slice(2,9)+"_"+Date.now().toString(36);
function hash(n){ n|=0; n=Math.imul(n^(n>>>16),0x45d9f3b); n=Math.imul(n^(n>>>16),0x45d9f3b); return (n^(n>>>16))>>>0; }
class RNG{
  constructor(seed){this.seed=(Number(seed)||1)>>>0;this.state=this.seed}
  next(){let t=this.state+=0x6D2B79F5;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return ((t^t>>>14)>>>0)/4294967296}
  range(a,b){return a+(b-a)*this.next()} int(a,b){return Math.floor(this.range(a,b+1))}
  pick(a){return a[Math.floor(this.next()*a.length)]}
}
const COLORS={grass:"#304a32",forest:"#233b2a",plain:"#66734c",mountain:"#5e6268",desert:"#9b7b48",swamp:"#354b43",snow:"#aebbc2",volcano:"#4d2c29",ruins:"#48475b",water:"#1b4560",road:"#756548",village:"#4b493b"};
const CLASS_DATA={
 Warrior:{hp:145,mp:35,attack:18,defense:14,magic:4,speed:145,crit:6,luck:5,color:"#c7d0df",skill:"Golpe Poderoso"},
 Paladin:{hp:155,mp:60,attack:15,defense:18,magic:10,speed:128,crit:5,luck:7,color:"#f0d479",skill:"Luz Restauradora"},
 Mage:{hp:92,mp:130,attack:9,defense:6,magic:25,speed:130,crit:8,luck:8,color:"#bb8cff",skill:"Orbe Arcano"},
 Archer:{hp:108,mp:55,attack:17,defense:8,magic:7,speed:168,crit:13,luck:10,color:"#75d69b",skill:"Disparo Perfurante"},
 Assassin:{hp:105,mp:45,attack:23,defense:7,magic:5,speed:188,crit:19,luck:12,color:"#e986aa",skill:"Lâmina Sombria"}
};
const ENEMY_TYPES=[
 ["Slime",18,5,2,42,14,"plain"],["Goblin",30,8,4,55,22,"forest"],["Lobo",34,10,3,82,28,"forest"],
 ["Esqueleto",48,12,7,48,40,"ruins"],["Orc",72,17,10,40,62,"mountain"],["Aranha",42,13,5,70,46,"swamp"],
 ["Troll",125,24,15,28,120,"mountain"],["Bandido",65,18,8,58,75,"plain"],["Golem",180,29,25,22,210,"mountain"],
 ["Draconato",240,36,20,45,320,"volcano"]
];
const WEAPONS=[
 ["Espada de Cinza","sword",8,3,105],["Lâmina Lunar","sword",13,7,110],["Montante do Norte","greatsword",20,2,88],
 ["Machado de Ferro","axe",15,4,92],["Lança do Vigia","spear",12,5,100],["Arco Élfico","bow",14,9,120],
 ["Cajado Astral","staff",7,6,100],["Adaga Sombria","dagger",11,12,135]
];
const RARITIES=[["Comum",1,"rar-common",.58],["Incomum",1.25,"rar-uncommon",.24],["Raro",1.6,"rar-rare",.105],["Épico",2.1,"rar-epic",.045],["Lendário",2.8,"rar-legendary",.022],["Mítico",3.7,"rar-mythic",.008]];

/* ---------- World generation ---------- */
class WorldGenerator{
  constructor(seed){this.seed=seed>>>0;this.rng=new RNG(seed);this.chunk=640;this.world=10000}
  noise(x,y){let s=hash(Math.floor(x)*374761393+Math.floor(y)*668265263+this.seed);return s/4294967295}
  smooth(x,y){const ix=Math.floor(x),iy=Math.floor(y),fx=x-ix,fy=y-iy;const a=this.noise(ix,iy),b=this.noise(ix+1,iy),c=this.noise(ix,iy+1),d=this.noise(ix+1,iy+1);const u=fx*fx*(3-2*fx),v=fy*fy*(3-2*fy);return a+(b-a)*u+(c-a)*v+(a-b-c+d)*u*v}
  fbm(x,y){let n=0,a=.5,f=.012;for(let i=0;i<4;i++){n+=this.smooth(x*f,y*f)*a;a*=.5;f*=2}return n}
  biome(x,y){
    if(Math.hypot(x,y)<500)return "village";
    const n=this.fbm(x,y), t=this.smooth(x*.004+100,y*.004-40);
    if(n<.24)return "water";
    if(n>.78&&t>.58)return "volcano";
    if(n>.72)return "mountain";
    if(t<.18)return "desert";
    if(t<.33)return "swamp";
    if(t>.84)return "snow";
    if(n>.58)return "forest";
    if(n<.38)return "plain";
    return "ruins";
  }
  resource(x,y){const b=this.biome(x,y);if(b==="forest")return "madeira";if(b==="mountain"||b==="volcano")return "minério";if(b==="swamp")return "ervas";if(b==="ruins")return "cristal";return "pedra"}
  enemyType(x,y,night=false){const b=this.biome(x,y);let arr=ENEMY_TYPES.filter(e=>e[6]===b||["plain","forest"].includes(b));if(!arr.length)arr=ENEMY_TYPES.slice(0,4);if(night)arr=arr.concat(ENEMY_TYPES.filter(e=>["ruins","swamp","volcano"].includes(e[6])));return this.rng.pick(arr)}
  structures(cx,cy){const r=new RNG(hash(cx*73856093+cy*19349663+this.seed));const out=[];for(let i=0;i<7;i++){let x=cx*this.chunk+r.range(50,this.chunk-50),y=cy*this.chunk+r.range(50,this.chunk-50),b=this.biome(x,y);if(b!=="water")out.push({x,y,type:r.pick(["tree","rock","resource","ruin","shrine"])})}return out}
}

/* ---------- Entities ---------- */
class Entity{constructor(o={}){Object.assign(this,{id:uid(),x:0,y:0,level:1,hp:10,maxHp:10,attack:3,defense:1,speed:50,dead:false},o)}}
class Enemy extends Entity{
  constructor(type,x,y,level,night=false){const e=type;super({x,y,level,hp:e[1]*(1+level*.16),maxHp:e[1]*(1+level*.16),attack:e[2]*(1+level*.11),defense:e[3]*(1+level*.08),speed:e[4],xp:e[5]*(1+level*.12),name:e[0],kind:e[0],state:"IDLE",aggro:110+(level*3),range:e[0]==="Aranha"?34:40,homeX:x,homeY:y,night});this.flash=0;this.attackCd=0;this.patrol=Math.random()*6}
}
class NPC extends Entity{constructor(name,type,x,y){super({x,y,name,type,level:1,hp:999,maxHp:999});this.talk=0}}
class Particle{constructor(x,y,color,vx,vy,life,size=3){Object.assign(this,{x,y,color,vx,vy,life,max:life,size})}update(dt){this.x+=this.vx*dt;this.y+=this.vy*dt;this.vy+=12*dt;this.life-=dt;return this.life>0}}
class Projectile{
  constructor(x,y,vx,vy,damage,isPlayer=true,color="#65d9ff",life=1.5){
    Object.assign(this,{id:uid("p"),x,y,vx,vy,damage,isPlayer,color,life,maxLife:life});
  }
  update(dt){this.x+=this.vx*dt;this.y+=this.vy*dt;this.life-=dt;return this.life>0;}
}

/* ---------- Player ---------- */
class Player extends Entity{
  constructor(data){
    super();
    const c=data?.class||"Warrior", d=CLASS_DATA[c]||CLASS_DATA.Warrior;
    this.name=data?.name||"Aventureiro";
    this.class=c;
    this.level=data?.level||1;
    this.x=data?.x??0;
    this.y=data?.y??0;
    this.xp=data?.xp||0;
    this.gold=data?.gold||80;
    this.points=data?.points||0;
    this.base={...d};
    this.hp=data?.hp??d.hp;
    this.mp=data?.mp??d.mp;
    this.stamina=data?.stamina??100;
    this.equipment=data?.equipment||{weapon:null,shield:null,head:null,chest:null,hands:null,legs:null,boots:null,accessory:null};
    this.inventory=data?.inventory||[];
    this.discovered=new Set(data?.discovered||[]);
    this.cooldowns={};
    this.block=false;
    this.blockTimer=null;
    this.invuln=0;
    this.attackCd=0;
    this.dash=0;
    this.hitDir=0;
  }
  stats(){
    let s={hp:this.base.hp+this.level*9,mp:this.base.mp+this.level*5,attack:this.base.attack+this.level*2,defense:this.base.defense+this.level,magic:this.base.magic+this.level, speed:this.base.speed,crit:this.base.crit,luck:this.base.luck};
    for(const it of Object.values(this.equipment))if(it){s.hp+=it.hp||0;s.mp+=it.mp||0;s.attack+=it.attack||0;s.defense+=it.defense||0;s.magic+=it.magic||0;s.crit+=it.crit||0;s.speed+=it.speed||0;s.luck+=it.luck||0}
    return s;
  }
  xpNeed(){return Math.floor(90*Math.pow(this.level,1.55))}
  gainXP(v){this.xp+=Math.floor(v);floatText(this.x+rand(-12,12),this.y-25,"+"+Math.floor(v)+" XP","#f1d56f");while(this.xp>=this.xpNeed()&&this.level<50){this.xp-=this.xpNeed();this.level++;this.points+=3;const s=this.stats();this.hp=s.hp;this.mp=s.mp;toast("LEVEL UP! Nível "+this.level);burst(this.x,this.y,CLASS_DATA[this.class].color,22);AudioFX.level()}}
  takeDamage(v,source){if(this.invuln>0)return;if(this.block)v=Math.floor(v*.38);const s=this.stats();v=Math.max(1,Math.floor(v-s.defense*.22));this.hp-=v;floatText(this.x,this.y-18,"-"+v,"#ff6f7e");this.invuln=.25;shake=5;if(this.hp<=0)die()}
  addItem(it){this.inventory.push(it);toast("Loot: "+it.name);AudioFX.loot()}
}

/* ---------- Game State & Engine ---------- */
const canvas=document.getElementById("world"),ctx=canvas.getContext("2d"),mapCanvas=document.getElementById("mapCanvas"),mctx=mapCanvas.getContext("2d");
let W=innerWidth,H=innerHeight,dpr=Math.min(devicePixelRatio||1,2);
function resize(){W=innerWidth;H=innerHeight;canvas.width=W*dpr;canvas.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0)}addEventListener("resize",resize);resize();
let seed=739281,gen,rng,player,enemies=[],npcs=[],projectiles=[],particles=[],texts=[],resources=[],chunks=new Map(),keys={},mouse={x:W/2,y:H/2,down:false},camera={x:0,y:0},gameTime=7,weather="clear",eventState=null,shake=0,last=performance.now(),running=false,settings={audio:true},wasNight=false;
let quest={state:"ACTIVE",id:"intro",title:"O chamado da fronteira",desc:"Converse com o Ancião da Vila.",target:"npc",progress:0,need:1,xp:100,gold:70};
const start=document.getElementById("start"),hud=document.getElementById("hud"),panel=document.getElementById("panel"),death=document.getElementById("death");

function rand(a,b){return (Math.random()*(b-a)+a)}
function biomeName(b){return ({village:"Vila",forest:"Floresta",plain:"Planície",mountain:"Montanha",desert:"Deserto",swamp:"Pântano",snow:"Neve",volcano:"Vulcão",ruins:"Ruínas",cave:"Cavernas",water:"Água"})[b]||b}
function toast(t){const e=document.getElementById("toast");e.textContent=t;e.classList.add("show");clearTimeout(toast.t);toast.t=setTimeout(()=>e.classList.remove("show"),2200)}
function floatText(x,y,t,c){texts.push({x,y,t,c,life:1.2,vy:-25})}
function burst(x,y,c,n=12){for(let i=0;i<n;i++){let a=Math.random()*Math.PI*2,s=rand(20,90);particles.push(new Particle(x,y,c,Math.cos(a)*s,Math.sin(a)*s,.45+Math.random()*.65,rand(1.5,4)))}}
function worldToScreen(x,y){return{x:x-camera.x+W/2,y:y-camera.y+H/2}}
function screenToWorld(x,y){return{x:x+camera.x-W/2,y:y+camera.y-H/2}}
function isNight(){return gameTime<5.5||gameTime>19}
function currentBiome(){return gen?gen.biome(player.x,player.y):"village"}

function makeChunk(cx,cy){
  const key=cx+","+cy;if(chunks.has(key))return chunks.get(key);
  const o={structures:gen.structures(cx,cy),enemies:[],resources:[]},r=new RNG(hash(cx*73856093+cy*19349663+seed));
  for(let i=0;i<6;i++){let x=cx*gen.chunk+r.range(35,gen.chunk-35),y=cy*gen.chunk+r.range(35,gen.chunk-35),b=gen.biome(x,y);if(b!=="water"&&Math.hypot(x,y)>300){let et=gen.enemyType(x,y,isNight());o.enemies.push(new Enemy(et,x,y,Math.max(1,Math.floor(Math.hypot(x,y)/650)+1),isNight()))}}
  for(let i=0;i<8;i++){let x=cx*gen.chunk+r.range(25,gen.chunk-25),y=cy*gen.chunk+r.range(25,gen.chunk-25);if(gen.biome(x,y)!=="water")o.resources.push({id:uid("r"),x,y,type:gen.resource(x,y),amount:r.int(1,3),respawn:0})}
  chunks.set(key,o);return o;
}
function ensureWorld(){
  const cx=Math.floor(player.x/gen.chunk),cy=Math.floor(player.y/gen.chunk);
  for(let y=cy-2;y<=cy+2;y++)for(let x=cx-2;x<=cx+2;x++){const ch=makeChunk(x,y);for(const e of ch.enemies)if(!enemies.includes(e)&&!e.dead)enemies.push(e);for(const r of ch.resources)if(!resources.includes(r))resources.push(r)}
  enemies=enemies.filter(e=>Math.abs(e.x-player.x)<gen.chunk*2.7&&Math.abs(e.y-player.y)<gen.chunk*2.7&&!e.dead);
  resources=resources.filter(r=>Math.abs(r.x-player.x)<gen.chunk*2.7);
}
function spawnNPCs(){npcs=[
 new NPC("Eldrin, o Ancião","quest",70,-40),new NPC("Mira, Mercadora","merchant",135,35),
 new NPC("Brom, Ferreiro","smith",135,-35),new NPC("Lyra, Curandeira","healer",-75,55),
 new NPC("Kael, Mestre de Classe","class",-70,-45)
]}

function newGame(cls="Warrior"){
  seed=Number(document.getElementById("seedInput").value)||Math.floor(Math.random()*9999999);
  gen=new WorldGenerator(seed);
  rng=new RNG(seed);
  player=new Player({class:cls,name:"Aventureiro"});
  enemies=[];projectiles=[];resources=[];chunks.clear();particles=[];texts=[];
  gameTime=7;weather="clear";eventState=null;
  const firstQuest=GENESIS_CONFIG.quests?.[0]||{id:"intro",title:"O chamado da fronteira",desc:"Converse com Eldrin, o Ancião.",target:"npc",need:1,xp:100,gold:70,next:""};
  quest={state:"ACTIVE",...firstQuest,progress:0};
  spawnNPCs();
  running=true;
  start.classList.add("hidden");
  hud.classList.remove("hidden");
  save();
  toast("Iniciando jornada como "+cls+"! Seed "+seed);
  AudioFX.start();
}

function save(){
  if(!player)return;
  const data={version:1,seed,player:{name:player.name,class:player.class,level:player.level,x:player.x,y:player.y,xp:player.xp,gold:player.gold,points:player.points,hp:player.hp,mp:player.mp,stamina:player.stamina,equipment:player.equipment,inventory:player.inventory,discovered:[...player.discovered]},quest,settings};
  try{localStorage.setItem("astraeon_save",JSON.stringify(data))}catch(e){toast("Não foi possível salvar")}
}
function load(){
  try{
    const raw=localStorage.getItem("astraeon_save");if(!raw)return false;
    const d=JSON.parse(raw);if(!d||!d.player||!Number.isFinite(d.seed))return false;
    seed=d.seed;gen=new WorldGenerator(seed);rng=new RNG(seed);
    player=new Player(d.player);quest=d.quest||quest;settings={...settings,...(d.settings||{})};
    chunks.clear();enemies=[];projectiles=[];resources=[];particles=[];texts=[];
    spawnNPCs();
    running=true;
    start.classList.add("hidden");
    hud.classList.remove("hidden");
    toast("Progresso restaurado!");
    return true;
  }catch(e){localStorage.removeItem("astraeon_save");return false}
}
function resetSave(){localStorage.removeItem("astraeon_save");toast("Save removido")}
function die(){
  player.hp=0;player.block=false;
  if(player.blockTimer){clearTimeout(player.blockTimer);player.blockTimer=null;}
  running=false;death.classList.remove("hidden");save();AudioFX.death();
}
function respawn(){
  player.x=0;player.y=0;player.block=false;
  if(player.blockTimer){clearTimeout(player.blockTimer);player.blockTimer=null;}
  const s=player.stats();player.hp=s.hp;player.mp=s.mp;player.stamina=100;player.invuln=2;
  running=true;death.classList.add("hidden");toast("Você reapareceu na Vila")
}

/* UI Menu Class Selector Render */
function renderMenuClasses(){
  const container = document.getElementById("classGridMenu");
  container.innerHTML = Object.entries(CLASS_DATA).map(([c,d])=>`
    <div class="classChoice" onclick="newGame('${c}')">
      <b>${c}</b>
      <small>HP ${d.hp} • ATK ${d.attack} • DEF ${d.defense}<br><em>${d.skill}</em></small>
    </div>
  `).join('');
}

document.getElementById("newBtn").onclick=()=>{
  document.getElementById("mainButtons").classList.add("hidden");
  document.getElementById("classSelectView").classList.remove("hidden");
  renderMenuClasses();
};
document.getElementById("backMenuBtn").onclick=()=>{
  document.getElementById("classSelectView").classList.add("hidden");
  document.getElementById("mainButtons").classList.remove("hidden");
};

function rewardQuest(){
  if(quest.state!=="COMPLETED")return;
  const mult=GENESIS_CONFIG.systems.quests.rewardMultiplier||1;
  player.gainXP(quest.xp*mult);player.gold+=Math.floor(quest.gold*mult);const doneId=quest.id;quest.state="CLAIMED";
  const next=GENESIS_CONFIG.quests?.find(q=>q.id===doneId)?.next;
  const nq=GENESIS_CONFIG.quests?.find(q=>q.id===next);
  if(nq) setTimeout(()=>{quest={state:"ACTIVE",...nq,progress:0};toast("Nova missão: "+nq.title);},250);
  toast("Missão concluída! +"+Math.floor(quest.gold*mult)+" Gold");burst(player.x,player.y,"#f0d479",28);
}
function advanceQuest(kind){
  if(quest.state!=="ACTIVE")return;
  if(quest.target===kind){
    quest.progress++;
    if(quest.progress>=quest.need){
      quest.state="COMPLETED";
      toast("Objetivo concluído — retorne ao NPC");
    }
  }
}
function interact(){
  let nearest=npcs.reduce((a,n)=>!a||dist(player,n)<dist(player,a)?n:a,null);
  if(nearest&&dist(player,nearest)<75){
    if(nearest.type==="merchant")openShop();
    else if(nearest.type==="smith")openSmith();
    else if(nearest.type==="healer"){player.hp=player.stats().hp;player.mp=player.stats().mp;toast("Lyra restaurou sua vitalidade.")}
    else if(nearest.type==="class"){openCharacter()}
    else if(nearest.type==="quest"){
      if(quest.state==="COMPLETED")rewardQuest();
      else advanceQuest("npc");
    }
  }
}
function weightedRarity(luck=0){
  let r=Math.random(),acc=0;for(const x of RARITIES){acc+=x[3]*(1+luck/100);if(r<acc)return x}return RARITIES[0]
}
function generateLoot(e){
  const rare=weightedRarity(player.stats().luck), mult=rare[1]*(1+e.level*.07);
  if(GENESIS_CONFIG.items?.catalog && GENESIS_CONFIG.items.catalog.length > 0){
    const list=GENESIS_CONFIG.items.catalog;
    const baseItem=list[Math.floor(Math.random()*list.length)];
    let it={
      id:uid("it"),
      name:baseItem.name + (rare[0]==="Comum"?"":` (${rare[0]})`),
      type:baseItem.type||"weapon",
      slot:baseItem.slot||itemSlotFor(baseItem)||"weapon",
      rarity:rare[0],
      rarClass:rare[2],
      level:Math.max(1,baseItem.level||e.level),
      attack:Math.floor((baseItem.attack||0)*mult),
      defense:Math.floor((baseItem.defense||0)*mult),
      magic:Math.floor((baseItem.magic||0)*mult),
      hp:Math.floor((baseItem.hp||0)*mult),
      mp:Math.floor((baseItem.mp||0)*mult),
      crit:Math.floor((baseItem.crit||0)*mult),
      speed:Math.floor(baseItem.speed||0),
      luck:Math.floor((baseItem.luck||0)*mult),
      heal:baseItem.heal||0,
      price:Math.floor((baseItem.price||18)*mult),
      description:baseItem.description||"",
      image:baseItem.image||""
    };
    return it;
  }
  const w=WEAPONS[Math.floor(Math.random()*WEAPONS.length)];
  const tr=Math.random();const type=tr<.36?"weapon":tr<.55?"armor":tr<.70?"shield":"accessory";
  let it={id:uid("it"),name:w[0],type,rarity:rare[0],rarClass:rare[2],level:Math.max(1,e.level),attack:0,defense:0,hp:0,mp:0,crit:0,speed:0,luck:0,price:Math.floor(18*mult)};
  if(type==="weapon"){it.attack=Math.floor(w[2]*mult);it.crit=Math.floor(w[3]*mult);it.speed=w[4]-100}
  else if(type==="shield"){it.name=["Escudo de Carvalho","Égide de Ferro","Escudo Rúnico"][Math.floor(Math.random()*3)];it.defense=Math.floor((5+e.level*1.8)*mult);it.hp=Math.floor(8*mult)}
  else if(type==="accessory"){const anames=["Anel","Amuleto","Colar","Pingente"];it.name=anames[Math.floor(Math.random()*4)]+" "+rare[0];it.luck=Math.floor(rand(1,5)*mult);it.crit=Math.floor(rand(0,4)*mult);it.mp=Math.floor(rand(2,10)*mult);it.hp=Math.floor(rand(2,8)*mult)}
  else {it.name=["Peitoral","Botas","Luvas","Capacete","Calças"][Math.floor(Math.random()*5)]+" "+rare[0];it.defense=Math.floor((3+e.level)*mult);it.hp=Math.floor(12*mult);it.speed=Math.floor(rand(-5,8));it.luck=Math.floor(rand(0,4)*mult)}
  return it
}
function itemSlotFor(it){if(!it)return null;if(it.slot&&['weapon','shield','head','chest','hands','legs','boots','accessory'].includes(it.slot))return it.slot;if(it.type==='weapon')return 'weapon';if(it.type==='shield')return 'shield';if(it.type==='accessory')return 'accessory';const n=String(it.name||'');if(/Peitoral|Armadura|Chest/i.test(n))return 'chest';if(/Botas|Boots/i.test(n))return 'boots';if(/Luvas|Gloves/i.test(n))return 'hands';if(/Capacete|Helmet/i.test(n))return 'head';if(/Calças|Pants/i.test(n))return 'legs';return null}
function equipItem(it,forcedSlot=null){if(!it)return false;const req=Number(it.level||1);if(player.level<req){toast(`Nível insuficiente: requer Lv ${req}`);return false}const slot=forcedSlot||itemSlotFor(it);if(!slot||!Object.prototype.hasOwnProperty.call(player.equipment,slot)){toast('Slot incompatível');return false}const old=player.equipment[slot];if(old)player.inventory.push(old);player.equipment[slot]=it;player.inventory=player.inventory.filter(x=>x!==it);toast('Equipado: '+it.name);updateHUD();save();return true}
function unequipSlot(slot){const it=player.equipment[slot];if(!it)return;player.inventory.push(it);player.equipment[slot]=null;toast('Desequipado: '+it.name);save();openPanel('inventory')}

function sellItem(i){let it=player.inventory[i];if(!it)return;player.gold+=Math.max(1,Math.floor(it.price*.65));player.inventory.splice(i,1);toast("Vendido por Gold");save()}

function attackTarget(target,heavy=false){
  if(player.attackCd>0)return;const s=player.stats(),d=dist(player,target);if(d>(GENESIS_CONFIG.systems.combat.meleeRange||125))return;
  player.attackCd=heavy?0.75:.36;let crit=Math.random()<s.crit/100,raw=s.attack+(heavy?s.attack*(GENESIS_CONFIG.systems.combat.heavyMultiplier||1.65)-s.attack:0),damage=Math.max(1,Math.floor(raw-target.defense*.35));if(crit)damage=Math.floor(damage*(GENESIS_CONFIG.systems.combat.critMultiplier||1.8));
  target.hp-=damage;target.flash=.12;floatText(target.x,target.y-20,(crit?"CRÍTICO ":"")+damage,crit?"#ffe17d":"#fff");burst(target.x,target.y,crit?"#ffe17d":"#dce9ff",crit?12:6);shake=(crit?7:3)*GENESIS_CONFIG.systems.graphics.screenShake;AudioFX.hit(crit);
  if(target.hp<=0)killEnemy(target)
}
function nearestEnemy(){let best=null,bd=Infinity;for(const e of enemies){let d=dist(player,e);if(d<bd&&d<155&&!e.dead){best=e;bd=d}}return best}
function killEnemy(e){
  e.dead=true;e.hp=0;burst(e.x,e.y,"#ff7180",18);genesisRunLogic("enemy_defeated",{enemy:e});player.gainXP(e.xp*GENESIS_CONFIG.gameplay.xpMultiplier);player.gold+=Math.floor(e.xp*.25*GENESIS_CONFIG.gameplay.xpMultiplier);floatText(e.x,e.y-35,"+"+Math.floor(e.xp*.25)+" Gold","#f0d479");if(e.kind==="Goblin")advanceQuest("goblin");
  if(Math.random()<clamp((GENESIS_CONFIG.items?.lootChance??.72)*GENESIS_CONFIG.gameplay.lootMultiplier,0,1))player.addItem(generateLoot(e));if(Math.random()<(GENESIS_CONFIG.items?.consumableChance??.22))player.addItem({id:uid("p"),name:rng.pick(["Poção de Vida","Poção de Mana","Erva Azul"]),type:"consumable",rarity:"Comum",rarClass:"rar-common",heal:35,price:12});
  AudioFX.death()
}
function shootProjectile(angle,speed,damage,isPlayer=true,color="#65d9ff"){
  projectiles.push(new Projectile(player.x,player.y,Math.cos(angle)*speed,Math.sin(angle)*speed,damage,isPlayer,color,1.6));
}
function useSkill(i){
  const s=player.stats(),now=performance.now()/1000, cd=player.cooldowns[i]||0;if(now<cd)return;
  let cost=0,need="mp",target=nearestEnemy();
  
  if(player.class==="Archer"&&(i===0||i===1||i===4)){
    let targetPos=screenToWorld(mouse.x,mouse.y);
    let angle=Math.atan2(targetPos.y-player.y,targetPos.x-player.x);
    if(i===0){
      if(player.attackCd>0)return;
      player.attackCd=0.32;
      shootProjectile(angle,420,Math.floor(s.attack*1.1),true,"#75d69b");
      AudioFX.hit(false);
      return;
    }
    if(i===1){
      cost=15;need="mp";
      if(player.mp>=cost){
        player.cooldowns[i]=now+2.5;
        shootProjectile(angle-0.15,440,Math.floor(s.attack*0.9),true,"#75d69b");
        shootProjectile(angle,440,Math.floor(s.attack*1.3),true,"#f0d479");
        shootProjectile(angle+0.15,440,Math.floor(s.attack*0.9),true,"#75d69b");
        AudioFX.magic();
      }
    }
    if(i===4){
      cost=28;need="mp";
      if(player.mp>=cost){
        player.cooldowns[i]=now+6;
        for(let a=-0.3;a<=0.3;a+=0.15){
          shootProjectile(angle+a,500,Math.floor((s.attack+s.magic)*1.2),true,"#ff77b8");
        }
        shake=8*GENESIS_CONFIG.systems.graphics.screenShake;
        AudioFX.magic();
      }
    }
  } else {
    if(i===0){if(target)attackTarget(target,false);return}
    if(i===1){cost=18;need="mp";if(target&&dist(player,target)<180){player.cooldowns[i]=now+3;let dmg=Math.floor(s.magic*2.5+s.attack*.3);target.hp-=dmg;floatText(target.x,target.y-20,dmg,"#b98cff");burst(target.x,target.y,"#b98cff",20);if(target.hp<=0)killEnemy(target);AudioFX.magic()}}
    if(i===4){cost=28;need="mp";if(target&&dist(player,target)<220){player.cooldowns[i]=now+7;let dmg=Math.floor((s.attack+s.magic)*2.2);target.hp-=dmg;floatText(target.x,target.y-28,dmg,"#ff77b8");burst(target.x,target.y,"#ff77b8",35);shake=12*GENESIS_CONFIG.systems.graphics.screenShake;if(target.hp<=0)killEnemy(target);AudioFX.magic()}}
  }

  if(i===2){
    player.block=true;
    player.cooldowns[i]=now+.8;
    if(player.blockTimer)clearTimeout(player.blockTimer);
    player.blockTimer=setTimeout(()=>{player.block=false;player.blockTimer=null;},650);
    toast("Bloqueio")
  }
  if(i===3){player.invuln=.55;player.dash=.25;player.cooldowns[i]=now+2;burst(player.x,player.y,"#65d9ff",12)}
  if(i===5){cost=20;need="mp";if(player.mp>=cost){player.cooldowns[i]=now+4;player.hp=clamp(player.hp+Math.floor(s.magic*2.4),0,s.hp);burst(player.x,player.y,"#6de39b",20);toast("Cura")}}
  if(i===6){player.invuln=.35;player.dash=.5;player.cooldowns[i]=now+3;burst(player.x,player.y,"#65d9ff",18)}
  if(i===7){cost=45;need="mp";if(player.mp>=cost){if(target&&dist(player,target)<300){player.cooldowns[i]=now+15;let dmg=Math.floor((s.attack+s.magic)*4);target.hp-=dmg;floatText(target.x,target.y-30,dmg,"#f3d56f");burst(target.x,target.y,"#f3d56f",60);shake=18*GENESIS_CONFIG.systems.graphics.screenShake;if(target.hp<=0)killEnemy(target);AudioFX.magic()}}}
  
  if(cost){if(player[need]<cost){toast("Recurso insuficiente");return}player[need]-=cost}
}

/* Modals & UI Panels */
function openPanel(type){
  if(!panel.classList.contains("hidden") && panel.dataset.panelType===type){panel.classList.add("hidden");return;}
  panel.dataset.panelType=type;
  panel.classList.remove("hidden");panel.classList.toggle("inventory-compact",type==="inventory");panel.classList.toggle("map-compact",type==="map");let body="";
  if(type==="inventory")body=inventoryHTML();
  if(type==="character")body=characterHTML();
  if(type==="quests")body=questHTML();
  if(type==="map")body=mapHTML();
  if(type==="settings")body=settingsHTML();
  panel.innerHTML=body;
  panel.querySelectorAll("[data-close]").forEach(b=>b.onclick=()=>panel.classList.add("hidden"));
  panel.querySelectorAll("[data-equip]").forEach(b=>b.onclick=()=>{equipItem(player.inventory[+b.dataset.equip]);openPanel("inventory")});  panel.querySelectorAll("[data-inv-index]").forEach(el=>{el.onclick=()=>{const i=+el.dataset.invIndex;window.__invSelectedIndex=i;equipItem(player.inventory[i]);};el.onmouseenter=e=>showInventoryDetails(+el.dataset.invIndex);el.onmousemove=e=>{const t=panel.querySelector("#invTooltip");if(t&&!t.hidden){t.style.left=Math.min(e.clientX+14,innerWidth-265)+"px";t.style.top=Math.min(e.clientY+14,innerHeight-180)+"px"}};el.onmouseleave=()=>{const t=panel.querySelector("#invTooltip");if(t)t.hidden=true};el.oncontextmenu=e=>{e.preventDefault();const i=+el.dataset.invIndex;window.__invSelectedIndex=i;equipItem(player.inventory[i]);};el.ondragstart=e=>e.dataTransfer.setData('text/plain',el.dataset.invIndex)});
  panel.querySelectorAll("[data-drop-slot]").forEach(el=>{el.ondragover=e=>{e.preventDefault();el.classList.add('dragover')};el.ondragleave=()=>el.classList.remove('dragover');el.ondrop=e=>{e.preventDefault();el.classList.remove('dragover');const i=+e.dataTransfer.getData('text/plain');equipItem(player.inventory[i],el.dataset.dropSlot)}});
  panel.querySelectorAll("[data-action='equipSelected']").forEach(b=>b.onclick=()=>{const i=window.__invSelectedIndex;if(i!=null)equipItem(player.inventory[i]);else toast('Selecione um item')});
  panel.querySelectorAll("[data-action='useSelected']").forEach(b=>b.onclick=()=>{const i=window.__invSelectedIndex,it=player.inventory[i];if(it?.heal){player.hp=clamp(player.hp+it.heal,0,player.stats().hp);player.inventory.splice(i,1);save();openPanel('inventory')}else toast('Este item não pode ser usado')});

  panel.querySelectorAll("[data-sell]").forEach(b=>b.onclick=()=>{sellItem(+b.dataset.sell);if(panel.querySelector("#shopTitle"))openShop();else openPanel("inventory");});
  panel.querySelectorAll("[data-use]").forEach(b=>b.onclick=()=>{let it=player.inventory[+b.dataset.use];if(it?.heal){player.hp=clamp(player.hp+it.heal,0,player.stats().hp);player.inventory.splice(+b.dataset.use,1);toast("Poção utilizada");openPanel("inventory");save()}});
  panel.querySelectorAll("[data-buy]").forEach(b=>b.onclick=()=>buy(+b.dataset.buy));
  panel.querySelectorAll("[data-class]").forEach(b=>b.onclick=()=>changeClass(b.dataset.class));
  const saveBtn=panel.querySelector("#saveNow");if(saveBtn)saveBtn.onclick=()=>{save();toast("Jogo salvo")}
  const audioBtn=panel.querySelector("#audioToggle");if(audioBtn)audioBtn.onclick=()=>{settings.audio=!settings.audio;audioBtn.textContent=settings.audio?"Desativar":"Ativar";save()};
  const resetBtn=panel.querySelector("#resetNow");if(resetBtn)resetBtn.onclick=()=>{if(confirm("Resetar todo o progresso salvo?")){resetSave();location.reload()}};
  if(type==="map")setTimeout(drawBigMap,30);
}
function panelHead(title){return `<button class="close" data-close>×</button><h2 style="font:28px Georgia,serif;margin:0">${title}</h2>`}
function itemImage(it){return it?.image?`<img src="${it.image}" alt="">`:(it?.type==='weapon'?'⚔':it?.type==='shield'?'🛡':it?.type==='armor'?'🛡':it?.type==='accessory'?'◈':it?.type==='consumable'?'✚':'◆')}
function inventoryHTML(){const slots=[['head','Cabeça'],['chest','Peitoral'],['hands','Mãos'],['weapon','Arma'],['shield','Escudo'],['legs','Pernas'],['boots','Botas'],['accessory','Acessório']];return panelHead('Inventário 2.0')+`<div class="inventory-shell"><section><div class="inventory-grid">${Array.from({length:24},(_,i)=>{const it=player.inventory[i];return it?`<div class="inv-slot" draggable="true" data-inv-index="${i}">${itemImage(it)}<span class="itype">${it.type||'item'}</span><span class="level">Lv ${it.level||1}</span></div>`:`<div class="inv-slot empty"></div>`}).join('')}</div><div class="item-tooltip" id="invTooltip" hidden></div></section><aside class="equipment-panel"><h3 style="font-size:12px;margin:0 0 6px">Equipamentos</h3><div class="equipment-grid">${slots.map(([k,l])=>{const v=player.equipment[k];return `<div class="equip-slot ${v?'':'empty'}" data-drop-slot="${k}"><strong>${l}</strong>${v?`<div class="equip-item">${itemImage(v)}<span>${v.name}</span></div><small>Lv ${v.level||1}</small>`:`<div style="font-size:18px;color:#34415a">+</div>`}</div>`}).join('')}</div></aside></div>`}
function showInventoryDetails(i){const it=player.inventory[i],tip=document.getElementById('invTooltip');if(!it||!tip)return;tip.innerHTML=`<h4 class="${it.rarClass||''}">${it.name}</h4><p>Lv ${it.level||1} • ${it.type||'item'} • ${it.rarity||'Comum'}</p><div class="tipstats"><span>ATK +${it.attack||0}</span><span>DEF +${it.defense||0}</span><span>MAG +${it.magic||0}</span><span>HP +${it.hp||0}</span><span>MP +${it.mp||0}</span><span>CRIT +${it.crit||0}</span><span>SPD +${it.speed||0}</span><span>LUCK +${it.luck||0}</span></div><p>${it.description||'Item sem descrição.'}</p>`;tip.hidden=false}

function characterHTML(){
  let s=player.stats();
  return panelHead("Personagem")+`
  <div class="card" style="margin-top:18px">
    <h3>${player.name} — <span style="color:var(--gold)">${player.class}</span> — Nível ${player.level}</h3>
    <p>XP ${player.xp}/${player.xpNeed()} • Pontos livres: ${player.points}</p>
    <div class="grid">${Object.entries({HP:s.hp,MP:s.mp,Ataque:s.attack,Defesa:s.defense,Magia:s.magic,Velocidade:s.speed,Crit:""+s.crit+"%",Sorte:s.luck}).map(([k,v])=>`<div class="card"><b>${k}</b><p style="font-size:18px;color:var(--text)">${v}</p></div>`).join("")}</div>
  </div>
  <h3>Trocar de Classe</h3>
  <div class="classGrid">${Object.keys(CLASS_DATA).map(c=>`<button class="classChoice ${c===player.class?"active":""}" data-class="${c}"><b>${c}</b><small>${CLASS_DATA[c].skill}</small></button>`).join("")}</div>`;
}
function questHTML(){return panelHead("Missões")+`<div class="card" style="margin-top:18px"><h3>${quest.title}</h3><p>${quest.desc}</p><p>Progresso: ${quest.progress}/${quest.need}</p><p>Recompensa: ${quest.xp} XP + ${quest.gold} Gold</p><b>${quest.state}</b></div><div class="card"><h3>Eventos do mundo</h3><p>${eventState?eventState.name:"Nenhum evento ativo."}</p><p>O mundo possui invasões, tempestades, eclipses, caravanas e aparições.</p></div>`}
function mapHTML(){return panelHead("Mapa do Mundo")+`<p style="color:var(--muted)">Seed ${seed} • Região atual: <b>${biomeName(currentBiome())}</b> • Descobertas: ${player.discovered.size}</p><canvas id="bigMap" width="720" height="432" style="width:100%;height:auto;background:#08101a;border:1px solid var(--line);border-radius:14px"></canvas>`}
function settingsHTML(){return panelHead("Configurações")+`<div class="grid" style="margin-top:20px"><div class="card"><h3>Áudio</h3><button class="btn" id="audioToggle">${settings.audio?"Desativar":"Ativar"}</button></div><div class="card"><h3>Persistência</h3><button class="btn" id="saveNow">Salvar agora</button><button class="btn" id="resetNow">Resetar progresso</button></div><div class="card"><h3>Controles</h3><p>WASD mover • Mouse mirar/atacar • E interagir</p><p>1-8 habilidades • I C M Q ESC</p></div></div>`}
function openInventory(){openPanel("inventory")}
function openCharacter(){openPanel("character")}
function toggleGamePanel(type){if(!panel.classList.contains("hidden")&&panel.dataset.panelType===type)panel.classList.add("hidden");else openPanel(type)}
function openShop(){
  panel.classList.remove("hidden");
  let buyHtml = "";
  if (GENESIS_CONFIG.items?.catalog && GENESIS_CONFIG.items.catalog.length > 0) {
    buyHtml = GENESIS_CONFIG.items.catalog.slice(0, 12).map((it, idx) => {
      const cost = it.price || 50;
      const statLabel = it.attack ? `ATK +${it.attack}` : it.defense ? `DEF +${it.defense}` : it.magic ? `MAG +${it.magic}` : it.heal ? `Cura +${it.heal}` : "Material";
      return `<div class="card" style="display:flex;align-items:center;gap:10px;">
        ${it.image ? `<img src="${it.image}" style="width:32px;height:32px;object-fit:contain;background:#050810;border-radius:4px;">` : '◈'}
        <div style="flex:1;">
          <h4 style="margin:0;font-size:12px;">${it.name}</h4>
          <small style="color:var(--muted);">${statLabel} • Lv ${it.level||1}</small>
        </div>
        <button class="btn" data-buy-catalog="${idx}" style="padding:4px 8px;font-size:11px;">${cost} G</button>
      </div>`;
    }).join("");
  } else {
    buyHtml = [0,1,2,3,4,5].map(i=>{let w=WEAPONS[i],cost=40+i*30;return `<div class="card"><h4>${w[0]}</h4><p>ATK +${w[2]} • Crit +${w[3]} • ${cost} Gold</p><button class="btn" data-buy="${i}">Comprar</button></div>`}).join("");
  }
  
  panel.innerHTML=panelHead("Mercado de Mira")+`<p style="color:var(--muted)">Gold disponível: ${player.gold}</p>
  <h3>Comprar</h3>
  <div class="grid">${buyHtml}</div>
  <h3>Vender Itens da Bolsa</h3>
  <div class="grid">${player.inventory.map((it,i)=>`<div class="card"><h4 class="${it.rarClass||""}">${it.name}</h4><p>Valor: ${Math.max(1,Math.floor(it.price*.65))} Gold</p><button class="btn" data-sell="${i}">Vender</button></div>`).join("")||`<p style="color:var(--muted)">Sua bolsa está vazia.</p>`}</div>`;
  panel.querySelectorAll("[data-close]").forEach(b=>b.onclick=()=>panel.classList.add("hidden"));
  panel.querySelectorAll("[data-buy]").forEach(b=>b.onclick=()=>buy(+b.dataset.buy));
  panel.querySelectorAll("[data-buy-catalog]").forEach(b=>b.onclick=()=>buyCatalog(+b.dataset.buyCatalog));
  panel.querySelectorAll("[data-sell]").forEach(b=>b.onclick=()=>{sellItem(+b.dataset.sell);openShop();});
}
function openSmith(){
  panel.classList.remove("hidden");
  let maxHp=player.stats().hp;
  let missing=maxHp-player.hp;
  let cost=Math.ceil(missing*0.4);
  panel.innerHTML=panelHead("Ferreiro Brom")+`<p style="color:var(--muted)">Ferreiro de Armas e Armaduras</p>
  <div class="card" style="margin-top:15px">
    <h3>Reparo de Vitalidade & Equipamentos</h3>
    <p>Restaura sua integridade de combate. Custo estimado: <b>${cost} Gold</b></p>
    <button class="btn primary" id="repairBtn">Reparar Tudo (${cost} Gold)</button>
  </div>`;
  panel.querySelectorAll("[data-close]").forEach(b=>b.onclick=()=>panel.classList.add("hidden"));
  const btn=panel.querySelector("#repairBtn");
  if(btn)btn.onclick=()=>{
    if(player.gold<cost){toast("Gold insuficiente!");return;}
    player.gold-=cost;
    player.hp=maxHp;
    toast("Equipamentos e vitalidade totalmente reparados!");
    openSmith();
    save();
  };
}
function buy(i){let w=WEAPONS[i],cost=40+i*30;if(player.gold<cost){toast("Gold insuficiente");return}player.gold-=cost;player.addItem({id:uid("it"),name:w[0],type:"weapon",rarity:"Comum",rarClass:"rar-common",attack:w[2],crit:w[3],price:cost});openShop();save()}
function buyCatalog(i){
  const list = GENESIS_CONFIG.items?.catalog;
  if(!list) return;
  const baseItem = list[i];
  if(!baseItem) return;
  const cost = baseItem.price || 50;
  if(player.gold<cost){toast("Gold insuficiente");return}
  player.gold-=cost;
  player.addItem({
    id:uid("it"),
    name:baseItem.name,
    type:baseItem.type||"weapon",
    slot:baseItem.slot||itemSlotFor(baseItem)||"weapon",
    rarity:"Comum",
    rarClass:"rar-common",
    level:baseItem.level||1,
    attack:baseItem.attack||0,
    defense:baseItem.defense||0,
    magic:baseItem.magic||0,
    hp:baseItem.hp||0,
    mp:baseItem.mp||0,
    crit:baseItem.crit||0,
    speed:baseItem.speed||0,
    luck:baseItem.luck||0,
    heal:baseItem.heal||0,
    price:cost,
    description:baseItem.description||"",
    image:baseItem.image||""
  });
  openShop();
  save();
}
function changeClass(c){if(!CLASS_DATA[c]||player.class===c)return;player.class=c;player.base={...CLASS_DATA[c]};const s=player.stats();player.hp=s.hp;player.mp=s.mp;toast("Classe alterada para: "+c);openCharacter();save()}
function openMapBig(){openPanel("map")}
function drawBigMap(){const c=document.getElementById("bigMap");if(!c)return;const x=c.getContext("2d"),S=c.width/50;x.clearRect(0,0,c.width,c.height);for(let j=0;j<30;j++)for(let i=0;i<50;i++){let wx=(i-25)*200,wy=(j-15)*200,b=gen.biome(wx,wy);x.fillStyle=COLORS[b]||"#222";x.fillRect(i*S,j*S,S+1,S+1)}x.fillStyle="#fff";x.beginPath();x.arc(25*S+S/2,15*S+S/2,5,0,7);x.fill()}

/* ---------- Audio ---------- */
const AudioFX={ctx:null,ensure(){if(!settings.audio)return;if(!this.ctx)this.ctx=new (window.AudioContext||window.webkitAudioContext)()},tone(f,d=.08,type="sine",gain=.035){if(!settings.audio)return;try{this.ensure();let o=this.ctx.createOscillator(),g=this.ctx.createGain();o.type=type;o.frequency.value=f;g.gain.value=gain;o.connect(g);g.connect(this.ctx.destination);o.start();g.gain.exponentialRampToValueAtTime(.0001,this.ctx.currentTime+d);o.stop(this.ctx.currentTime+d)}catch(e){}},hit(c){this.tone(c?180:95,.07,"square",.025)},magic(){this.tone(520,.18,"sine",.025)},loot(){this.tone(760,.12);setTimeout(()=>this.tone(1020,.15),70)},level(){this.tone(520,.12);setTimeout(()=>this.tone(780,.2),100)},death(){this.tone(80,.3,"sawtooth",.025)},start(){this.tone(360,.1)}};
document.addEventListener("pointerdown",()=>AudioFX.ensure(),{once:true});

/* ---------- Input ---------- */
addEventListener("keydown",e=>{
  keys[e.key.toLowerCase()]=true;
  if([" ","ArrowUp","ArrowDown","ArrowLeft","ArrowRight"].includes(e.key))e.preventDefault();
  if(e.key.toLowerCase()==="i")toggleGamePanel("inventory");
  if(e.key.toLowerCase()==="c")toggleGamePanel("character");
  if(e.key.toLowerCase()==="m")toggleGamePanel("map");
  if(e.key.toLowerCase()==="q")toggleGamePanel("quests");
  if(e.key.toLowerCase()==="e")interact();
  if(e.key==="Escape")panel.classList.add("hidden");
  if(/^[1-8]$/.test(e.key))useSkill(+e.key-1);
});
addEventListener("keyup",e=>keys[e.key.toLowerCase()]=false);
canvas.addEventListener("mousemove",e=>{mouse.x=e.clientX;mouse.y=e.clientY});
canvas.addEventListener("mousedown",e=>{if(e.button===0){mouse.down=true;AudioFX.ensure()}});
addEventListener("mouseup",e=>{if(e.button===0){mouse.down=false;}});
canvas.addEventListener("contextmenu",e=>e.preventDefault());
document.querySelectorAll(".slot").forEach(b=>b.onclick=()=>useSkill(+b.dataset.skill));
document.getElementById("continueBtn").onclick=()=>{if(!load())toast("Nenhum save válido encontrado")};
document.getElementById("settingsBtn").onclick=()=>openPanel("settings");
document.getElementById("randomSeed").onclick=()=>document.getElementById("seedInput").value=Math.floor(Math.random()*9999999);
document.getElementById("respawnBtn").onclick=respawn;

/* ---------- Game Loop ---------- */
function update(dt){
  if(!running)return;
  ensureWorld();
  const s=player.stats();let vx=(keys.d?1:0)-(keys.a?1:0),vy=(keys.s?1:0)-(keys.w?1:0),len=Math.hypot(vx,vy)||1;
  const gameMult = GENESIS_CONFIG.gameplay || {};
  const moveMult = gameMult.movementMultiplier !== undefined ? gameMult.movementMultiplier : 1;
  const dashMult = gameMult.dashMultiplier !== undefined ? gameMult.dashMultiplier : 2.8;
  const maxStam = gameMult.staminaMax !== undefined ? gameMult.staminaMax : 100;
  const drainStam = gameMult.staminaDrain !== undefined ? gameMult.staminaDrain : 4;
  const recStam = gameMult.staminaRecovery !== undefined ? gameMult.staminaRecovery : 18;
  let sp=s.speed*(player.dash>0?dashMult:1)*moveMult;
  if(player.stamina<maxStam)player.stamina=clamp(player.stamina+recStam*dt,0,maxStam);
  if((vx||vy)&&player.stamina>0){player.x+=vx/len*sp*dt;player.y+=vy/len*sp*dt;player.stamina=clamp(player.stamina-drainStam*dt,0,maxStam)}
  player.attackCd=Math.max(0,player.attackCd-dt);player.invuln=Math.max(0,player.invuln-dt);player.dash=Math.max(0,player.dash-dt);
  if(mouse.down){let target=nearestEnemy();if(target)attackTarget(target,false)}
  camera.x+=(player.x-camera.x)*Math.min(1,dt*7);camera.y+=(player.y-camera.y)*Math.min(1,dt*7);
  gameTime=(gameTime+dt*GENESIS_CONFIG.gameplay.daySpeed)%24;const nowNight=isNight();if(nowNight&&!wasNight)genesisRunLogic("night_start",{message:"A noite chegou. Criaturas perigosas estão mais ativas."});wasNight=nowNight;
  const b=currentBiome(),key=Math.floor(player.x/300)+":"+Math.floor(player.y/300);if(!player.discovered.has(key)){player.discovered.add(key);genesisRunLogic("region_discovered",{key});if(quest.id==="explore"&&quest.target==="biome"){const unique=new Set([...player.discovered].map(k=>{let [x,y]=k.split(":").map(Number);return gen.biome(x*300,y*300)}));quest.progress=clamp(unique.size-1,0,quest.need);if(quest.progress>=quest.need)quest.state="COMPLETED"}}
  if(Math.random()<dt*GENESIS_CONFIG.gameplay.weatherChance*GENESIS_CONFIG.systems.graphics.weather){weather=rng.pick(["clear","rain","storm"]);toast(weather==="clear"?"O céu abriu.":"O clima mudou: "+weather)}
  if(Math.random()<dt*GENESIS_CONFIG.gameplay.eventChance&&!eventState){eventState={name:rng.pick(["Invasão de Goblins","Caravana Perdida","Tesouro Oculto","Eclipse"]),life:35};toast("Evento: "+eventState.name)}
  if(eventState){eventState.life-=dt;if(eventState.life<=0)eventState=null}
  for(const e of enemies)updateEnemy(e,dt);
  
  projectiles=projectiles.filter(p=>{
    let alive=p.update(dt);
    if(!alive)return false;
    if(p.isPlayer){
      for(const e of enemies){
        if(!e.dead&&dist(p,e)<20){
          e.hp-=p.damage;
          e.flash=.12;
          floatText(e.x,e.y-20,p.damage,"#75d69b");
          burst(e.x,e.y,p.color,8);
          if(e.hp<=0)killEnemy(e);
          return false;
        }
      }
    }
    return true;
  });

  resources.forEach(r=>{if(r.respawn>0)r.respawn-=dt;if(r.respawn<=0&&r.amount<=0)r.amount=1})
  particles=particles.filter(p=>p.update(dt));texts=texts.filter(t=>(t.y+=t.vy*dt,t.life-=dt,t.life>0));
  shake=Math.max(0,shake-dt*18);updateHUD();
  if(Math.random()<dt*.015)save();
}

function updateEnemy(e,dt){
  if(e.dead)return;
  e.flash=Math.max(0,e.flash-dt);e.attackCd=Math.max(0,e.attackCd-dt);let d=dist(player,e);
  if(d<e.aggro*GENESIS_CONFIG.gameplay.enemyAggroMultiplier)e.state="CHASE";else e.state="PATROL";
  if(e.state==="CHASE"&&d>e.range){e.x+=(player.x-e.x)/Math.max(d,1)*e.speed*dt;e.y+=(player.y-e.y)/Math.max(d,1)*e.speed*dt}
  if(d<e.range&&e.attackCd<=0){e.state="ATTACK";e.attackCd=Math.max(.55,1.2-e.level*.015);player.takeDamage(e.attack*GENESIS_CONFIG.gameplay.enemyDamageMultiplier*(.85+Math.random()*.3),e);burst(player.x,player.y,"#ff6678",5)}
  if(e.state==="PATROL"){e.patrol+=dt;let a=e.patrol*.35+e.id.length;e.x+=Math.cos(a)*e.speed*.12*dt;e.y+=Math.sin(a*.8)*e.speed*.12*dt}
}

/* ---------- Render Engine ---------- */
function draw(){
  ctx.save();
  const sx=shake?(Math.random()-.5)*shake:0,sy=shake?(Math.random()-.5)*shake:0;
  ctx.translate(sx,sy);
  ctx.fillStyle="#071019";
  ctx.fillRect(-10,-10,W+20,H+20);

  /* Renderização de segurança: mesmo que a geração do mundo ainda não esteja pronta,
     o jogo continua mostrando uma cena jogável em vez de uma tela vazia. */
  if(!gen || !player){
    const g=ctx.createLinearGradient(0,0,0,H);g.addColorStop(0,"#0d1b27");g.addColorStop(1,"#16251d");
    ctx.fillStyle=g;ctx.fillRect(-10,-10,W+20,H+20);
    ctx.restore();
    return;
  }

  const worldCfg=GENESIS_CONFIG?.world||{};
  const tile=Math.max(32,Number(worldCfg.tileSize)||80);
  const x0=Math.floor((camera.x-W/2)/tile)-1,x1=Math.ceil((camera.x+W/2)/tile)+1;
  const y0=Math.floor((camera.y-H/2)/tile)-1,y1=Math.ceil((camera.y+H/2)/tile)+1;
  const density=Number(worldCfg.decorationDensity)||1;

  for(let y=y0;y<=y1;y++) for(let x=x0;x<=x1;x++){
    const wx=x*tile,wy=y*tile,b=gen.biome(wx,wy),col=COLORS[b]||"#26352c";
    const sx0=wx-camera.x+W/2,sy0=wy-camera.y+H/2;
    ctx.fillStyle=col;ctx.fillRect(sx0,sy0,tile+1,tile+1);

    /* textura do terreno */
    const n=gen.noise(x,y);
    if(b==="water"){
      ctx.fillStyle="rgba(115,220,255,.11)";
      ctx.fillRect(sx0,sy0+10+n*20,tile+1,2);
      ctx.fillRect(sx0+18,sy0+42+n*15,tile*.55,1);
    }else{
      ctx.fillStyle="rgba(255,255,255,.035)";
      if(n>Math.max(.18,.84-density*.14)){
        ctx.beginPath();ctx.arc(sx0+tile*n,sy0+tile*(1-n),2+n*3.5,0,Math.PI*2);ctx.fill();
      }
      if(b==="forest"||b==="plain"||b==="village"){
        ctx.strokeStyle="rgba(20,35,18,.18)";ctx.lineWidth=1;
        ctx.beginPath();ctx.moveTo(sx0+8,sy0+tile-8);ctx.lineTo(sx0+tile-8,sy0+8);ctx.stroke();
      }
    }
  }

  drawRoads();drawStructures();drawResources();drawAttackRanges();drawNPCs();drawEnemies();drawProjectiles();drawPlayer();drawParticles();drawTexts();drawWeather();
  ctx.restore();
  drawMiniMap();
}
function drawRoads(){ctx.strokeStyle="rgba(170,145,105,.28)";ctx.lineWidth=12;ctx.beginPath();let a=worldToScreen(-300,0),b=worldToScreen(800,0);ctx.moveTo(a.x,a.y);ctx.lineTo(b.x,b.y);ctx.stroke();ctx.lineWidth=5}
function drawStructures(){
  for(const h of [{x:-110,y:-110},{x:130,y:-120},{x:-130,y:120},{x:120,y:120}]){
    let p=worldToScreen(h.x,h.y);
    ctx.fillStyle="rgba(0,0,0,.24)";ctx.beginPath();ctx.ellipse(p.x,p.y+20,34,10,0,0,Math.PI*2);ctx.fill();
    ctx.fillStyle="#4a3430";ctx.fillRect(p.x-25,p.y-18,50,38);
    ctx.fillStyle="#a66b45";ctx.beginPath();ctx.moveTo(p.x-33,p.y-18);ctx.lineTo(p.x,p.y-45);ctx.lineTo(p.x+33,p.y-18);ctx.closePath();ctx.fill();
    ctx.fillStyle="#1b2430";ctx.fillRect(p.x-6,p.y+2,12,18);ctx.fillStyle="#c8a76b";ctx.fillRect(p.x+12,p.y-9,7,7);
  }
  const cx0=Math.floor(player.x/gen.chunk)-2,cx1=Math.floor(player.x/gen.chunk)+2,cy0=Math.floor(player.y/gen.chunk)-2,cy1=Math.floor(player.y/gen.chunk)+2;
  for(let cy=cy0;cy<=cy1;cy++)for(let cx=cx0;cx<=cx1;cx++){const ch=chunks.get(cx+","+cy);if(!ch)continue;for(const s of ch.structures){let p=worldToScreen(s.x,s.y);if(p.x<-40||p.x>W+40||p.y<-40||p.y>H+40)continue;
    if(s.type==="tree"){ctx.fillStyle="#3a5a36";ctx.fillRect(p.x-3,p.y-6,6,18);ctx.fillStyle="#2f6b2c";ctx.beginPath();ctx.arc(p.x,p.y-16,16,0,7);ctx.fill()}
    else if(s.type==="rock"){ctx.fillStyle="#7a7d86";ctx.beginPath();ctx.arc(p.x,p.y,13,0,7);ctx.fill();ctx.fillStyle="#5a5d66";ctx.beginPath();ctx.arc(p.x-4,p.y-3,7,0,7);ctx.fill()}
    else if(s.type==="ruin"){ctx.fillStyle="#45412a";ctx.fillRect(p.x-16,p.y-8,8,22);ctx.fillRect(p.x+8,p.y-12,8,26);ctx.fillStyle="#7a7158";ctx.fillRect(p.x-20,p.y+12,40,4)}
    else if(s.type==="shrine"){ctx.fillStyle="#6a5b7a";ctx.beginPath();ctx.arc(p.x,p.y,14,0,7);ctx.fill();ctx.fillStyle="#c08cff";ctx.beginPath();ctx.arc(p.x,p.y-22,6,0,7);ctx.fill();ctx.strokeStyle="rgba(192,140,255,.6)";ctx.lineWidth=2;ctx.beginPath();ctx.arc(p.x,p.y,20,0,7);ctx.stroke()}
    else if(s.type==="resource"){ctx.fillStyle="#9c6b3a";ctx.beginPath();ctx.moveTo(p.x,p.y-14);ctx.lineTo(p.x+9,p.y+8);ctx.lineTo(p.x-9,p.y+8);ctx.closePath();ctx.fill()}
  }}
}
function drawResources(){for(const r of resources){if(r.amount<=0)continue;let p=worldToScreen(r.x,r.y);if(p.x<-30||p.x>W+30||p.y<-30||p.y>H+30)continue;ctx.fillStyle=r.type==="madeira"?"#68a45e":r.type==="minério"?"#b7c0c8":r.type==="cristal"?"#8e76db":r.type==="ervas"?"#67c789":"#aaa07a";ctx.beginPath();ctx.moveTo(p.x,p.y-9);ctx.lineTo(p.x+8,p.y+7);ctx.lineTo(p.x-8,p.y+7);ctx.closePath();ctx.fill()}}
function drawNPCs(){
  for(const n of npcs){
    let p=worldToScreen(n.x,n.y);if(p.x<-50||p.x>W+50||p.y<-50||p.y>H+50)continue;
    const base=GENESIS_CONFIG.visuals.npcs[n.id||n.type]||GENESIS_CONFIG.visuals.npcs[n.type]||{};
    const col=base.color||(n.type==="quest"?"#e6c46a":n.type==="merchant"?"#69d4ff":n.type==="smith"?"#e986aa":n.type==="healer"?"#6de39b":n.type==="class"?"#c8b8ff":"#d8d8e8");
    const scale=Number(base.scale)||1, size=32*scale, img=base.image?genesisGetImage(base.image):null;
    if(n.type==="quest"&&quest.state==="COMPLETED"){ctx.strokeStyle="rgba(230,196,106,.7)";ctx.lineWidth=3;ctx.beginPath();ctx.arc(p.x,p.y,24*scale,0,7);ctx.stroke()}
    if(img && img.complete && img.naturalWidth){
      genesisDrawAssetImage(img,p.x,p.y-size*.1,size,base.glow?col:null,Number(base.glowSize)||18);
    }else{
      if(base.glow){ctx.save();ctx.shadowBlur=14;ctx.shadowColor=col}
      ctx.fillStyle=col;ctx.beginPath();ctx.arc(p.x,p.y,16*scale,0,7);ctx.fill();ctx.restore?.();
      ctx.fillStyle="#0a0d14";ctx.fillRect(p.x-13*scale,p.y-22*scale,26*scale,5*scale);
      ctx.fillStyle="#fff";ctx.font="bold 14px sans-serif";ctx.textAlign="center";ctx.fillText(n.type==="quest"?"!":n.type==="merchant"?"$":n.type==="smith"?"⚒":n.type==="healer"?"+":n.type==="class"?"*":"?",p.x,p.y+5*scale);
    }
    ctx.fillStyle="#fff";ctx.font="10px sans-serif";ctx.textAlign="center";ctx.fillText(n.name.split(",")[0],p.x,p.y-size*.65);
    if(dist(player,n)<75){ctx.fillStyle="rgba(230,196,106,.9)";ctx.font="9px sans-serif";ctx.fillText("[E]"+(n.type==="quest"&&quest.state==="COMPLETED"?"!":""),p.x,p.y+size*.9)}
  }
}
function drawAttackRanges(){if(!player)return;const p=worldToScreen(player.x,player.y),pr=Number(GENESIS_CONFIG.systems?.combat?.meleeRange||125);ctx.save();ctx.beginPath();ctx.arc(p.x,p.y,pr,0,Math.PI*2);ctx.fillStyle='rgba(101,217,255,.035)';ctx.fill();ctx.strokeStyle='rgba(101,217,255,.34)';ctx.lineWidth=1.4;ctx.setLineDash([5,6]);ctx.stroke();ctx.setLineDash([]);ctx.fillStyle='rgba(150,225,255,.72)';ctx.font='700 9px sans-serif';ctx.textAlign='center';ctx.fillText('ALCANCE',p.x,p.y-pr-5);ctx.restore();for(const e of enemies){if(e.dead)continue;const ep=worldToScreen(e.x,e.y),rr=Number(e.range||40),danger=dist(player,e)<=rr;if(ep.x<-rr-50||ep.x>W+rr+50||ep.y<-rr-50||ep.y>H+rr+50)continue;ctx.save();ctx.beginPath();ctx.arc(ep.x,ep.y,rr,0,Math.PI*2);ctx.fillStyle=danger?'rgba(255,55,75,.095)':'rgba(255,70,90,.045)';ctx.fill();ctx.strokeStyle=danger?'rgba(255,75,90,.58)':'rgba(255,85,100,.28)';ctx.lineWidth=danger?1.8:1;ctx.setLineDash([3,5]);ctx.stroke();ctx.setLineDash([]);if(danger){ctx.fillStyle='rgba(255,125,135,.82)';ctx.font='700 8px sans-serif';ctx.fillText('PERIGO',ep.x,ep.y+rr+12)}ctx.restore()}}
function drawEnemies(){for(const e of enemies){if(e.dead)continue;let p=worldToScreen(e.x,e.y);if(p.x<-70||p.x>W+70||p.y<-70||p.y>H+70)continue;const d=genesisVisualMonster(e),r=(13+Math.min(10,e.level))*d.scale;ctx.save();ctx.translate(p.x,p.y);if(d.glow){ctx.shadowBlur=14;ctx.shadowColor=d.color}ctx.fillStyle=d.color;ctx.strokeStyle=d.outline;ctx.lineWidth=1.7;
const img=d.image?genesisGetImage(d.image):null;
if(img && img.complete && img.naturalWidth){
  genesisDrawAssetImage(img,0,0,r*2.25,d.glow?d.color:null,d.glowSize);
}else{
  genesisMonsterShape(d.shape,r);ctx.fill();ctx.stroke();genesisDrawEntityFace(r,e.kind);
}
ctx.shadowBlur=0;ctx.fillStyle="#0a0d14";ctx.fillRect(-18,-r-11,36,5);ctx.fillStyle="#e95d6b";ctx.fillRect(-18,-r-11,36*clamp(e.hp/e.maxHp,0,1),5);ctx.fillStyle="#f1d56f";ctx.font="9px sans-serif";ctx.textAlign="right";ctx.fillText("Lv "+e.level,-23,-r-9);ctx.fillStyle="#eaf1ff";ctx.font="700 10px sans-serif";ctx.textAlign="center";ctx.fillText(e.kind,0,-r-22);ctx.restore()}}
function drawProjectiles(){for(const p of projectiles){let pt=worldToScreen(p.x,p.y);ctx.fillStyle=p.color;ctx.beginPath();ctx.arc(pt.x,pt.y,4,0,Math.PI*2);ctx.fill()}}
function drawPlayer(){if(!player)return;let p=worldToScreen(player.x,player.y);genesisDrawPlayer(p);if(player.invuln>0){ctx.strokeStyle="rgba(101,217,255,.8)";ctx.lineWidth=2;ctx.beginPath();ctx.arc(p.x,p.y,27,0,7);ctx.stroke()}}
function drawParticles(){for(const q of particles){let p=worldToScreen(q.x,q.y);ctx.globalAlpha=clamp(q.life/q.max,0,1);ctx.fillStyle=q.color;ctx.beginPath();ctx.arc(p.x,p.y,q.size,0,7);ctx.fill()}ctx.globalAlpha=1}
function drawTexts(){ctx.textAlign="center";ctx.font="bold 13px sans-serif";for(const t of texts){let p=worldToScreen(t.x,t.y);ctx.globalAlpha=clamp(t.life,0,1);ctx.fillStyle=t.c;ctx.fillText(t.t,p.x,p.y)}ctx.globalAlpha=1}
function drawWeather(){if(weather==="rain"||weather==="storm"){ctx.strokeStyle="rgba(150,200,255,.22)";ctx.lineWidth=1;for(let i=0;i<80;i++){let x=(i*97+performance.now()/8)%W,y=(i*53+performance.now()/4)%H;ctx.beginPath();ctx.moveTo(x,y);ctx.lineTo(x-4,y+14);ctx.stroke()}}let night=clamp((Math.cos((gameTime-13)/24*Math.PI*2)+1)/2,0,GENESIS_CONFIG.world.nightStrength);if(isNight())night=GENESIS_CONFIG.world.nightStrength*.72;ctx.fillStyle=`rgba(7,12,35,${night*.65*GENESIS_CONFIG.world.atmosphere})`;ctx.fillRect(0,0,W,H)}
function drawMiniMap(){if(!gen||!player)return;mctx.clearRect(0,0,180,180);mctx.fillStyle="#07111a";mctx.fillRect(0,0,180,180);const scale=.09;for(let y=0;y<180;y+=4)for(let x=0;x<180;x+=4){let wx=player.x+(x-90)/scale,wy=player.y+(y-90)/scale;const known=player.discovered.has(Math.floor(wx/300)+":"+Math.floor(wy/300));mctx.fillStyle=known?(COLORS[gen.biome(wx,wy)]||"#222"):"#101a28";mctx.fillRect(x,y,5,5)}for(const e of enemies){if(dist(player,e)<500){let x=90+(e.x-player.x)*scale,y=90+(e.y-player.y)*scale;mctx.fillStyle="#ff6678";mctx.fillRect(x-2,y-2,4,4)}}for(const n of npcs){let x=90+(n.x-player.x)*scale,y=90+(n.y-player.y)*scale;mctx.fillStyle="#e6c46a";mctx.fillRect(x-2,y-2,4,4)}mctx.fillStyle="#fff";mctx.beginPath();mctx.arc(90,90,4,0,7);mctx.fill()}
function updateHUD(){if(!player)return;const s=player.stats();document.getElementById("pname").textContent=player.name;document.getElementById("pclass").textContent=player.class;document.getElementById("plevel").textContent=player.level;document.getElementById("hpbar").style.width=(clamp(player.hp/s.hp,0,1)*100)+"%";document.getElementById("mpbar").style.width=(clamp(player.mp/s.mp,0,1)*100)+"%";document.getElementById("xpbar").style.width=(player.xp/player.xpNeed()*100)+"%";const st=document.getElementById("staminabar");if(st)st.style.width=(clamp(player.stamina/(GENESIS_CONFIG.gameplay?.staminaMax||100),0,1)*100)+"%";document.getElementById("hptext").textContent=Math.ceil(player.hp)+"/"+s.hp;document.getElementById("mptext").textContent=Math.ceil(player.mp)+"/"+s.mp;document.getElementById("atktext").textContent=s.attack;document.getElementById("deftext").textContent=s.defense;document.getElementById("qtitle").textContent=quest.title;document.getElementById("qdesc").textContent=quest.desc;document.getElementById("qcount").textContent=quest.progress+"/"+quest.need;document.getElementById("qfill").style.width=(quest.progress/quest.need*100)+"%";if(eventState)document.getElementById("qdesc").textContent="EVENTO: "+eventState.name}
let genesisLastError="";
function loop(now){
  const dt=Math.min(.033,Math.max(0,(now-last)/1000));last=now;
  try{update(dt)}catch(err){
    if(genesisLastError!==String(err)){
      genesisLastError=String(err);
      console.error("[ASTRAEON UPDATE]",err);
      toast("Motor: recuperando a cena...");
    }
  }
  try{draw()}catch(err){
    if(genesisLastError!==String(err)){
      genesisLastError=String(err);
      console.error("[ASTRAEON DRAW]",err);
    }
  }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

