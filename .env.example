# ASTRAEON ONLINE — ENVIRONMENT TEMPLATE
# ------------------------------------------------------------
# This file is safe to commit because it contains placeholders only.
# Copy it to a local .env file or configure these values directly in Vercel.
# NEVER replace the placeholders in this .env.example with real credentials.
# ------------------------------------------------------------

# Public Supabase project URL used by /api/config.
SUPABASE_URL=https://PROJECT_REF.supabase.co

# Public/publishable Supabase key. This is intentionally a browser-safe key,
# but access must still be protected by RLS and Realtime policies.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Private Realtime topic namespace used by Astraeon.
ASTRAEON_REALTIME_TOPIC=world:astraeon:main

# Server-only progression authority. Configure these only in protected Vercel
# environments or a trusted game-server host; never expose them to the browser.
# Generate the authority token with at least 32 random bytes (for example,
# `openssl rand -base64 48`) and use a Supabase Secret Key when available.
ASTRAEON_AUTHORITY_TOKEN=REPLACE_WITH_A_LONG_RANDOM_SERVER_ONLY_TOKEN
SUPABASE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SUPABASE_SECRET

# ------------------------------------------------------------
# DO NOT ADD SECRETS HERE OR TO FRONTEND FILES.
# Examples of values that must remain server-side/private:
# - Supabase service-role / secret keys
# - database passwords or connection URLs containing passwords
# - Vercel personal access tokens
# - GitHub personal access tokens
# - private keys, cookies, refresh tokens or session secrets
#
# Store private values only in the hosting provider's protected Environment
# Variables when they are actually required by a server-side function.
# /api/config must never expose private secrets to the browser.
# ------------------------------------------------------------
